{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "customConditions": ["workspace"]
  },
  "include": [
    "scripts/**/*.mjs",
    "packages/*/scripts/**/*.mjs",
    "tests/unit/lib/**/*.mjs"
  ]
}

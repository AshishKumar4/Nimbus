{
  "$schema": "https://biomejs.dev/schemas/2.3.7/schema.json",
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off"
      }
    },
    "enabled": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/src/**",
      "**/scripts/**",
      "!node_modules",
      "!**/node_modules",
      "!**/worker-configuration.d.ts",
      "!package.json",
      "!**/package.json",
      "!dist",
      "!**/dist",
      "!.wrangler",
      "!**/.wrangler",
      "!wrangler.jsonc",
      "!**/wrangler.jsonc",
      "!./tsconfig.json",
      "!**/tsconfig.json",
      "!**/*.generated.ts",
      "!**/parallel/generated-workers.ts"
    ]
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "useKeyWithClickEvents": "off"
      },
      "complexity": {
        "noBannedTypes": "off"
      },
      "correctness": {
        "noUnusedFunctionParameters": "off",
        "noUnusedImports": "off",
        "noUnusedVariables": "off"
      },
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  // Per-file rule exemptions. Every `includes` path below must name a file
  // that exists: biome matches these literally, so a file that moves takes its
  // exemption with it silently — the rule simply starts firing (or stops) with
  // nobody deciding that. This list went stale exactly that way when core,
  // fabric and sdk were split out of worker, which is why 180 diagnostics
  // appeared in code nobody had touched. When you move a file, re-point its
  // entry here or delete it; when you fix the code, delete the entry.
  "overrides": [
    {
      "includes": [
        "packages/worker/src/session/nimbus-session.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noVoidTypeReturn": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/worker/src/facets/manager.ts",
        "packages/worker/src/facets/vite-dev-server.ts",
        "packages/worker/src/npm/installer.ts",
        "packages/worker/src/runtime/barrel-synthesizer.ts",
        "packages/worker/src/session/routes.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off"
          }
        }
      }
    },
    {
      // stripAnsi and stripVTControlCharacters exist to strip ANSI/VT escape
      // sequences, so matching ESC (0x1B) and BEL (0x07) is the whole job.
      // Every literal spelling is flagged — \x1b, \u001b, \u{1b}, [\u001b],
      // [\x00-\x1f], [^\x07\x1b] — and the one spelling the rule accepts,
      // \p{Cc}, matches all 33 C0 controls: it turns "foo\n[INFO] bar" into
      // "fooNFO] bar". Building the pattern through `new RegExp` only hides it
      // from the analyzer and trips useRegexLiterals instead. So the exemption
      // is the honest option here, and it is narrow: these two files, this
      // one rule.
      "includes": [
        "packages/core/src/runtime/process-logs.ts",
        "packages/core/src/substrate/lifo/node-compat/util.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noControlCharactersInRegex": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/hosted-demo/src/demo-agent-auth.ts",
        "apps/hosted-demo/src/demo-anon.ts",
        "apps/hosted-demo/src/demo-auth.ts",
        "apps/hosted-demo/src/demo-cleanup.ts",
        "apps/hosted-demo/src/demo-nimbus.ts",
        "apps/hosted-demo/src/demo-oauth-config.ts",
        "apps/hosted-demo/src/demo-sessions.ts",
        "apps/hosted-demo/src/index.ts",
        "apps/probe/src/index.ts",
        "packages/cli/src/commands/session.ts",
        "packages/worker/scripts/opencode/build-node.ts",
        "packages/worker/src/_shared/session-router.ts",
        "packages/worker/src/auth/token.ts",
        "packages/worker/src/bindings/d1.ts",
        "packages/worker/src/bindings/kv.ts",
        "packages/worker/src/bindings/r2.ts",
        "packages/worker/src/facets/cirrus-real.ts",
        "packages/worker/src/facets/exec-telemetry.ts",
        "packages/worker/src/facets/manager.ts",
        "packages/worker/src/facets/process.ts",
        "packages/worker/src/facets/real-vite-hmr.ts",
        "packages/worker/src/facets/vite-dev-server.ts",
        "packages/worker/src/facets/wasm-swap-registry.ts",
        "packages/worker/src/facets/ws-terminal.ts",
        "packages/worker/src/git/commands.ts",
        "packages/worker/src/git/network-facet.ts",
        "packages/worker/src/index.ts",
        "packages/worker/src/loaders/child-process/spawn-facet.ts",
        "packages/worker/src/loaders/child-process/spawn-pool.ts",
        "packages/worker/src/npm/cache.ts",
        "packages/worker/src/npm/install-batch-facet.ts",
        "packages/worker/src/npm/installer.ts",
        "packages/worker/src/npm/npx-install.ts",
        "packages/worker/src/npm/pre-bundle-facet.ts",
        "packages/worker/src/npm/r2-cache.ts",
        "packages/worker/src/npm/resolve-one-facet.ts",
        "packages/worker/src/npm/resolver.ts",
        "packages/worker/src/replica/routing.ts",
        "packages/worker/src/router/index.ts",
        "packages/worker/src/runtime/barrel-synthesizer.ts",
        "packages/worker/src/runtime/bun-repl.ts",
        "packages/worker/src/runtime/esbuild-wasm-bytes.ts",
        "packages/worker/src/runtime/node-repl.ts",
        "packages/worker/src/runtime/node-runner.ts",
        "packages/worker/src/runtime/package-manager.ts",
        "packages/worker/src/runtime/python-repl.ts",
        "packages/worker/src/runtime/repl-session.ts",
        "packages/worker/src/runtime/ruby-repl.ts",
        "packages/worker/src/runtime/runtime-catalog.ts",
        "packages/worker/src/session/agent.ts",
        "packages/worker/src/session/diag.ts",
        "packages/worker/src/session/fs-watch.ts",
        "packages/worker/src/session/helpers.ts",
        "packages/worker/src/session/hibernation.ts",
        "packages/worker/src/session/init-phases.ts",
        "packages/worker/src/session/init.ts",
        "packages/worker/src/session/internal.d.ts",
        "packages/worker/src/session/nimbus-session.ts",
        "packages/worker/src/session/replica-routes.ts",
        "packages/worker/src/session/routes.ts",
        "packages/worker/src/session/rpc.ts",
        "packages/worker/src/session/start-real-vite.ts",
        "packages/worker/src/session/state-store.ts",
        "packages/worker/src/session/supervisor-rpc.ts",
        "packages/worker/src/session/ws.ts",
        "packages/worker/src/wrangler/nimbus-wrangler.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/worker/src/facets/vite-dev-server.ts",
        "packages/worker/src/npm/installer.ts",
        "packages/worker/src/runtime/package-manager.ts",
        "packages/worker/src/session/ws.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noImplicitAnyLet": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": false,
    "useIgnoreFile": false
  }
}

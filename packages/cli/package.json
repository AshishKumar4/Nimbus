{
  "name": "@nimbus-sh/cli",
  "version": "0.2.3",
  "description": "Nimbus CLI \u2014 `create-nimbus-app` scaffolder + `token mint` + `runtime sync`.",
  "keywords": [
    "cloudflare",
    "workers",
    "sandbox",
    "cli",
    "developer-environment"
  ],
  "homepage": "https://github.com/AshishKumar4/Nimbus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshishKumar4/Nimbus.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/AshishKumar4/Nimbus/issues",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cli": "dist/bin.js",
    "nimbus": "dist/bin.js",
    "create-nimbus-app": "dist/scaffold-bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json --noCheck --noEmit false --declaration true --declarationMap true --outDir dist --rootDir src && chmod +x dist/bin.js dist/scaffold-bin.js",
    "prepublishOnly": "bun ../../scripts/dist-integrity.mjs --publish",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nimbus-sh/config": "^0.2.4",
    "@nimbus-sh/sdk": "^0.11.0",
    "@nimbus-sh/worker": "^0.13.0"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

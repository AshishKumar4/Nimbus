{
  "name": "@nimbus-sh/loom",
  "version": "0.3.5",
  "description": "The actor framework of Nimbus: partyserver's surface on top, the @nimbus-sh/fabric Durable Object floor pre-wired underneath.",
  "keywords": [
    "cloudflare",
    "workers",
    "durable-objects",
    "partyserver",
    "partykit",
    "actors",
    "websockets",
    "agents"
  ],
  "homepage": "https://github.com/AshishKumar4/Nimbus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshishKumar4/Nimbus.git",
    "directory": "packages/loom"
  },
  "bugs": "https://github.com/AshishKumar4/Nimbus/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "workspace": "./src/index.ts",
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "workspace": "./src/*.ts",
      "bun": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsrs -p tsconfig.json --noCheck --noEmit false --declaration true --declarationMap true --outDir dist --rootDir src",
    "prepublishOnly": "bun ../../scripts/dist-integrity.mjs --publish",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@nimbus-sh/fabric": "^0.22.0",
    "cron-schedule": "^6.0.0",
    "partyserver": "0.5.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  },
  "publishConfig": {
    "access": "public"
  }
}

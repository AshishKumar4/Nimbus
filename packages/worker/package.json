{
  "name": "@nimbus-sh/worker",
  "version": "0.13.3",
  "description": "Nimbus runtime package for Cloudflare Workers, re-exported publicly through @nimbus-sh/sdk/worker.",
  "keywords": [
    "cloudflare",
    "workers",
    "durable-objects",
    "webassembly",
    "sandbox",
    "runtime"
  ],
  "homepage": "https://github.com/AshishKumar4/Nimbus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshishKumar4/Nimbus.git",
    "directory": "packages/worker"
  },
  "bugs": "https://github.com/AshishKumar4/Nimbus/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workspace": {
      "workspace": "./src/workspace.ts",
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    },
    "./router": {
      "workspace": "./src/router/index.ts",
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    },
    "./auth": {
      "workspace": "./src/auth/index.ts",
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./session-id": {
      "workspace": "./src/_shared/session-id.ts",
      "types": "./dist/_shared/session-id.d.ts",
      "import": "./dist/_shared/session-id.js"
    },
    "./preview-host": {
      "workspace": "./src/_shared/preview-host.ts",
      "types": "./dist/_shared/preview-host.d.ts",
      "import": "./dist/_shared/preview-host.js"
    },
    "./workspace-host": {
      "workspace": "./src/workspace-host.ts",
      "types": "./dist/workspace-host.d.ts",
      "import": "./dist/workspace-host.js"
    },
    "./facet-host": {
      "workspace": "./src/runtime/facet-loader-host.ts",
      "types": "./dist/runtime/facet-loader-host.d.ts",
      "import": "./dist/runtime/facet-loader-host.js"
    },
    "./port-capability": {
      "workspace": "./src/session/port-capability.ts",
      "types": "./dist/session/port-capability.d.ts",
      "import": "./dist/session/port-capability.js"
    },
    "./durable-slots": {
      "workspace": "./src/facets/durable-slots.ts",
      "types": "./dist/facets/durable-slots.d.ts",
      "import": "./dist/facets/durable-slots.js"
    },
    "./git": {
      "workspace": "./src/git/commands.ts",
      "types": "./dist/git/commands.d.ts",
      "import": "./dist/git/commands.js"
    },
    "./session/programmatic": {
      "workspace": "./src/session/programmatic.ts",
      "types": "./dist/session/programmatic.d.ts",
      "import": "./dist/session/programmatic.js"
    },
    "./session/rpc": {
      "workspace": "./src/session/rpc.ts",
      "types": "./dist/session/rpc.d.ts",
      "import": "./dist/session/rpc.js"
    },
    "./session/supervisor-rpc": {
      "workspace": "./src/session/supervisor-rpc.ts",
      "types": "./dist/session/supervisor-rpc.d.ts",
      "import": "./dist/session/supervisor-rpc.js"
    },
    "./session/routes": {
      "workspace": "./src/session/routes.ts",
      "types": "./dist/session/routes.d.ts",
      "import": "./dist/session/routes.js"
    },
    "./runtime/package-manager": {
      "workspace": "./src/runtime/package-manager.ts",
      "types": "./dist/runtime/package-manager.d.ts",
      "import": "./dist/runtime/package-manager.js"
    },
    "./runtime-sync-helper": "./scripts/bundle-runtime.mjs",
    "./public/*": "./public/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vendor",
    "public",
    "scripts",
    "runtime-contracts",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "!public/**/*.map"
  ],
  "scripts": {
    "bundle:git": "node scripts/bundle-git.mjs",
    "bundle:facets": "node scripts/bundle-facet-workers.mjs",
    "bundle:esbuild": "node scripts/bundle-esbuild-wasm.mjs",
    "bundle:oxc": "node scripts/bundle-oxc-wasm.mjs",
    "bundle:sqlite": "node scripts/bundle-sqlite-wasm.mjs",
    "bundle:shims": "node scripts/bundle-node-shims.mjs",
    "bundle:tailwind": "node scripts/bundle-tailwind-play.mjs",
    "bundle:opencode": "node scripts/bundle-opencode.mjs",
    "bundle:napi-wasm": "node scripts/bundle-napi-wasm.mjs",
    "bundle:real-vite": "node scripts/bundle-real-vite.mjs",
    "bundle:plugin-react": "node scripts/bundle-plugin-react.mjs",
    "bundle:npm-cjs": "node scripts/bundle-npm-cjs.mjs",
    "bundle:agent-chat": "node scripts/bundle-agent-chat.mjs",
    "bundle:preview-isolation": "node scripts/bundle-preview-isolation.mjs",
    "bundle": "bun run bundle:git && bun run bundle:facets && bun run bundle:esbuild && bun run bundle:oxc && bun run bundle:sqlite && bun run bundle:shims && bun run bundle:tailwind && bun run bundle:opencode && bun run bundle:napi-wasm && bun run bundle:real-vite && bun run bundle:plugin-react && bun run bundle:npm-cjs && bun run bundle:agent-chat && bun run bundle:preview-isolation",
    "clean:dist": "node ../../scripts/clean-dist.mjs",
    "build": "bun run clean:dist && tsc -p tsconfig.json --noCheck --noEmit false --declaration true --declarationMap true --outDir dist --rootDir src",
    "prepublishOnly": "bun ../../scripts/dist-integrity.mjs --publish",
    "typecheck": "tsc --noEmit && tsc -p frontend --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@nimbus-sh/core": "^0.15.1",
    "@nimbus-sh/fabric": "^0.10.1",
    "@nimbus-sh/platform": "^0.7.2",
    "@renovatebot/pep440": "^5.0.0",
    "ai": "^6.0.182",
    "clean-git-ref": "^2.0.1",
    "crc-32": "^1.2.2",
    "diff": "^5.1.0",
    "diff3": "0.0.3",
    "esbuild-wasm": "0.24.2",
    "ignore": "^5.1.4",
    "is-git-ref-name-valid": "^1.0.0",
    "jsonc-parser": "3.3.1",
    "minimisted": "^2.0.1",
    "pako": "1.0.11",
    "pify": "^4.0.1",
    "pip-requirements-js": "^1.0.3",
    "readable-stream": "^3.4.0",
    "sha.js": "^2.4.12",
    "simple-get": "^4.0.1",
    "sql.js": "^1.14.1",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@babel/plugin-transform-react-jsx-self": "7.29.7",
    "@babel/plugin-transform-react-jsx-source": "7.29.7",
    "@babel/plugin-transform-typescript": "7.29.9",
    "@babel/types": "7.29.8",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@rollup/wasm-node": "4.60.4",
    "@vitejs/plugin-react": "4.3.4",
    "acorn": "^8.15.0",
    "cjs-module-lexer": "2.3.0",
    "dompurify": "3.4.12",
    "highlight.js": "11.11.1",
    "isomorphic-git": "npm:@ashishkumar472/cf-git@1.0.5",
    "marked": "18.0.6",
    "preact": "10.29.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-refresh": "0.14.2",
    "rolldown": "1.2.11",
    "scheduler": "0.23.2",
    "typescript": "^5.7.0",
    "vite": "6.4.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@nimbus-sh/worker",
  "version": "0.1.6",
  "description": "Nimbus runtime package for Cloudflare Workers, re-exported publicly through @nimbus-sh/sdk/worker.",
  "keywords": [
    "cloudflare",
    "workers",
    "durable-objects",
    "webassembly",
    "sandbox",
    "runtime"
  ],
  "homepage": "https://github.com/AshishKumar4/Nimbus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshishKumar4/Nimbus.git",
    "directory": "packages/worker"
  },
  "bugs": "https://github.com/AshishKumar4/Nimbus/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "workspace": "./src/router/index.ts",
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    },
    "./auth": {
      "workspace": "./src/auth/index.ts",
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./runtime-sync-helper": "./scripts/bundle-runtime.mjs",
    "./public/*": "./public/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "public",
    "scripts",
    "runtime-contracts",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "bundle:git": "node scripts/bundle-git.mjs",
    "bundle:facets": "node scripts/bundle-facet-workers.mjs",
    "bundle:esbuild": "node scripts/bundle-esbuild-wasm.mjs",
    "bundle:tailwind": "node scripts/bundle-tailwind-play.mjs",
    "bundle": "bun run bundle:git && bun run bundle:facets && bun run bundle:esbuild && bun run bundle:tailwind",
    "build": "tsc -p tsconfig.json --noCheck --noEmit false --declaration true --declarationMap true --outDir dist --rootDir src",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@lifo-sh/core": "^0.5.5",
    "ai": "^6.0.182",
    "clean-git-ref": "^2.0.1",
    "crc-32": "^1.2.2",
    "diff": "^9.0.0",
    "diff3": "^0.0.4",
    "esbuild-wasm": "0.24.2",
    "ignore": "^7.0.5",
    "is-git-ref-name-valid": "^1.0.0",
    "isomorphic-git": "npm:@ashishkumar472/cf-git@1.0.5",
    "minimisted": "^2.0.1",
    "pako": "1.0.11",
    "pify": "^6.1.0",
    "readable-stream": "^4.7.0",
    "sha.js": "^2.4.12",
    "simple-get": "^4.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250327.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

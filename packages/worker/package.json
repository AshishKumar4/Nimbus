{
  "name": "@nimbus-sh/worker",
  "version": "0.1.6",
  "description": "Nimbus runtime package for Cloudflare Workers, re-exported publicly through @nimbus-sh/sdk/worker.",
  "keywords": [
    "cloudflare",
    "workers",
    "durable-objects",
    "webassembly",
    "sandbox",
    "runtime"
  ],
  "homepage": "https://github.com/AshishKumar4/Nimbus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshishKumar4/Nimbus.git",
    "directory": "packages/worker"
  },
  "bugs": "https://github.com/AshishKumar4/Nimbus/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "workspace": "./src/router/index.ts",
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    },
    "./auth": {
      "workspace": "./src/auth/index.ts",
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./session-id": {
      "workspace": "./src/_shared/session-id.ts",
      "types": "./dist/_shared/session-id.d.ts",
      "import": "./dist/_shared/session-id.js"
    },
    "./preview-host": {
      "workspace": "./src/_shared/preview-host.ts",
      "types": "./dist/_shared/preview-host.d.ts",
      "import": "./dist/_shared/preview-host.js"
    },
    "./runtime-sync-helper": "./scripts/bundle-runtime.mjs",
    "./public/*": "./public/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "public",
    "scripts",
    "runtime-contracts",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "bundle:git": "node scripts/bundle-git.mjs",
    "bundle:facets": "node scripts/bundle-facet-workers.mjs",
    "bundle:esbuild": "node scripts/bundle-esbuild-wasm.mjs",
    "bundle:sqlite": "node scripts/bundle-sqlite-wasm.mjs",
    "bundle:shims": "node scripts/bundle-node-shims.mjs",
    "bundle:tailwind": "node scripts/bundle-tailwind-play.mjs",
    "bundle:opencode": "node scripts/bundle-opencode.mjs",
    "bundle:agent-chat": "node scripts/bundle-agent-chat.mjs",
    "bundle": "bun run bundle:git && bun run bundle:facets && bun run bundle:esbuild && bun run bundle:sqlite && bun run bundle:shims && bun run bundle:tailwind && bun run bundle:opencode && bun run bundle:agent-chat",
    "clean:dist": "node scripts/clean-dist.mjs",
    "build": "npm run clean:dist && tsc -p tsconfig.json --noCheck --noEmit false --declaration true --declarationMap true --outDir dist --rootDir src",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p frontend --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@renovatebot/pep440": "^5.0.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.5",
    "ai": "^6.0.182",
    "clean-git-ref": "^2.0.1",
    "crc-32": "^1.2.2",
    "diff": "^9.0.0",
    "diff3": "^0.0.4",
    "esbuild-wasm": "0.24.2",
    "ignore": "^7.0.5",
    "is-git-ref-name-valid": "^1.0.0",
    "isomorphic-git": "npm:@ashishkumar472/cf-git@1.0.5",
    "magic-string": "^0.30.21",
    "minimisted": "^2.0.1",
    "pako": "1.0.11",
    "pify": "^6.1.0",
    "pip-requirements-js": "^1.0.3",
    "readable-stream": "^4.7.0",
    "sha.js": "^2.4.12",
    "simple-get": "^4.0.1",
    "sql.js": "^1.14.1",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250327.0",
    "dompurify": "3.4.12",
    "highlight.js": "11.11.1",
    "marked": "18.0.6",
    "preact": "10.29.7",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

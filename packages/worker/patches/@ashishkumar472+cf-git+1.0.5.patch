+/**
+ * A config file's text, null where there is none (ENOENT, ENOTDIR). A file
+ * there that cannot be read (EACCES, EIO) is no empty configuration: its
+ * failure is thrown, as git's access_or_die dies of it, with the file it
+ * names (`configFile`: the path the filesystem read, else this one).
+ */
+async function readConfigText(fs, path) {
+  try {
+    return await fs._readFile(path, { encoding: 'utf8' })
+  } catch (err) {
+    if (err && (err.code === 'ENOENT' || err.code === 'ENOTDIR')) return null
+    const failure = new Error(`unable to access '${(err && err.path) || path}'`);
+    failure.code = err && err.code;
+    failure.configFile = (err && err.path) || path;
+    failure.cause = err;
+    throw failure
+  }

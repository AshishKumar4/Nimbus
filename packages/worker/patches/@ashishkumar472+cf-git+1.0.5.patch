+   * The configuration for a reader that never changes it: the file is read
+   * every time, and parsed only when its text is not the one last parsed
+   * for that path (the same text is the same configuration).
+   */
+  static async read({ fs, gitdir }) {
+    const path = `${gitdir}/config`;
+    const text = await readConfigText(fs, path);
+    const known = parsedConfigs.get(path);
+    if (known !== undefined && known.text === text) return known.config
+    const config = GitConfig.from(text);
+    parsedConfigs.delete(path);
+    parsedConfigs.set(path, { text, config });
+    // The paths read last are kept; a session reads few.
+    if (parsedConfigs.size > 32) parsedConfigs.delete(parsedConfigs.keys().next().value);
+    return config
+  }

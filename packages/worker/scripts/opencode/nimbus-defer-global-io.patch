+export async function ensureDirs() {
+  await Promise.all([
+    fs.mkdir(Path.data, { recursive: true }),
+    fs.mkdir(Path.config, { recursive: true }),
+    fs.mkdir(Path.state, { recursive: true }),
+    fs.mkdir(Path.tmp, { recursive: true }),
+    fs.mkdir(Path.log, { recursive: true }),
+    fs.mkdir(Path.bin, { recursive: true }),
+    fs.mkdir(Path.repos, { recursive: true }),
+  ])
+}
+
+// Nimbus runs this bundle inside a workerd Worker Loader, where module
+// top-level await runs in "global scope" and async I/O (the VFS supervisor
+// RPC backing fs.mkdir) is disallowed. The Nimbus runner sets the flag and
+// the CLI entry awaits ensureDirs() from inside its handler. Under Bun this
+// flag is unset and the dirs are created at import as before.
+if (!(globalThis as any).__NIMBUS_OPENCODE_DEFER) {
+  await ensureDirs()
+}
 
 export class Service extends Context.Service<Service, Interface>()("@opencode/Global") {}
 

diff --git a/packages/core/src/zig/lib.zig b/packages/core/src/zig/lib.zig
index 5f33e48b..3d919a33 100644
--- a/packages/core/src/zig/lib.zig
+++ b/packages/core/src/zig/lib.zig
@@ -72,6 +72,29 @@ const globalAllocator = gpa.allocator();
 var arena = std.heap.ArenaAllocator.init(globalAllocator);
 const globalArena = arena.allocator();
 
+/// wasm copy-in/copy-back arena protocol: the host has no FFI views into
+/// linear memory, so it allocates scratch regions through these exports,
+/// writes arguments in, calls the FFI, reads results back, and frees.
+/// 16-byte alignment covers every extern struct and scalar layout in the
+/// FFI surface. wasm-only: the native dylib export surface is unchanged.
+fn nimbusAlloc(size: usize) callconv(.c) ?[*]u8 {
+    const mem = globalAllocator.alignedAlloc(u8, .@"16", size) catch return null;
+    return mem.ptr;
+}
+
+fn nimbusFree(ptr: ?[*]u8, size: usize) callconv(.c) void {
+    const base = ptr orelse return;
+    const slice: []align(16) u8 = @alignCast(base[0..size]);
+    globalAllocator.free(slice);
+}
+
+comptime {
+    if (@import("builtin").target.cpu.arch.isWasm()) {
+        @export(&nimbusAlloc, .{ .name = "nimbus_alloc" });
+        @export(&nimbusFree, .{ .name = "nimbus_free" });
+    }
+}
+
 pub const ExternalBuildOptions = extern struct {
     gpa_safe_stats: bool,
     gpa_memory_limit_tracking: bool,

diff --git a/Makefile b/Makefile
index d7b1b21..015aa21 100644
--- a/Makefile
+++ b/Makefile
@@ -133,6 +133,7 @@ include shared.mak
 #
 # Define NO_MMAP if you want to avoid mmap.
 # Define NO_MMAP_PAGED with NO_MMAP to page pack indexes via compat/mmap.c.
+# Define NO_FORK when the platform supplies git_spawnvpe instead of fork.
 #
 # Define MMAP_PREVENTS_DELETE if a file that is currently mmapped cannot be
 # deleted or cannot be replaced using rename().
@@ -1990,6 +1991,9 @@ endif
 ifdef NO_INITGROUPS
 	BASIC_CFLAGS += -DNO_INITGROUPS
 endif
+ifdef NO_FORK
+	COMPAT_CFLAGS += -DNO_FORK
+endif
 ifdef NO_MMAP
 	COMPAT_CFLAGS += -DNO_MMAP
 	COMPAT_OBJS += compat/mmap.o

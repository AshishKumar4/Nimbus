--- a/run-command.c
+++ b/run-command.c
@@ -745,7 +745,7 @@ fail_pipe:
 	if (cmd->close_object_store)
 		odb_close(the_repository->objects);
 
-#ifndef GIT_WINDOWS_NATIVE
+#if !defined(GIT_WINDOWS_NATIVE) && !defined(NO_FORK)
 {
 	int notify_pipe[2];
 	int null_fd = -1;
@@ -932,9 +932,15 @@ end_of_spawn:
 		cmd->args.v = prepare_shell_cmd(&nargv, sargv);
 
 	trace_argv_printf(cmd->args.v, "trace: start_command:");
+#ifdef NO_FORK
+	cmd->pid = git_spawnvpe(cmd->args.v[0], cmd->args.v,

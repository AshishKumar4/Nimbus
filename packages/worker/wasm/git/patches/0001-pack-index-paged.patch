+/*
+ * `len` bytes of the pack index at `offset`. The pointer is valid until the
+ * next call: copy what has to outlive it.
+ */
+static inline const unsigned char *pack_index_at(const struct packed_git *p, size_t offset,
+						 size_t len UNUSED)
+{
+#ifdef NO_MMAP_PAGED
+	return git_mmap_read(p->index_data, offset, len);
+#else
+	return (const unsigned char *)p->index_data + offset;
+#endif
+}
+static inline const unsigned char *pack_index_whole(const struct packed_git *p)
+{
+#ifdef NO_MMAP_PAGED
+	return git_mmap_whole(p->index_data);
+#else
+	return p->index_data;
+#endif
+}

diff -r a/unwind_prot.c b/unwind_prot.c
--- a/unwind_prot.c	2021-12-22 09:49:36.000000000 -0600
+++ b/unwind_prot.c	2026-10-13 00:47:45.414383671 -0500
@@ -46,6 +46,7 @@
 #include "command.h"
 #include "general.h"
 #include "unwind_prot.h"
+#include "bashjmp.h"	/* Nimbus: procenv_t, for unwind_protect_procenv */
 #include "sig.h"
 #include "quit.h"
 #include "bashintl.h"	/* for _() */
@@ -99,9 +100,20 @@
 #define uwpfree(elt)	free(elt)
 #else
 #define uwpalloc(elt)	ocache_alloc (uwcache, UNWIND_ELT, elt)
-#define uwpfree(elt)	ocache_free (uwcache, UNWIND_ELT, elt)
+#define uwpfree(elt)	do { procenv_release (elt); ocache_free (uwcache, UNWIND_ELT, elt); } while (0)
 #endif
 
+static void restore_procenv PARAMS((SAVED_VAR *));
+
+/* Nimbus: the saved procenv_t an element holds ends with the element. */
+static inline void
+procenv_release (elt)
+     UNWIND_ELT *elt;
+{
+  if (elt->head.cleanup == (Function *) restore_procenv)
+    nimbus_procenv_drop (elt->sv.v.desired_setting);
+}
+
 void
 uwp_init ()
 {
@@ -253,11 +265,17 @@
 clear_unwind_protects_internal (flag, ignore)
      char *flag, *ignore;
 {
+  UNWIND_ELT *elt;
+
   if (flag)
     {
       while (unwind_protect_list)
 	remove_unwind_protect_internal ((char *)NULL, (char *)NULL);
     }
+  else
+    /* Nimbus: the list is forgotten, not freed: its saved procenvs end here. */
+    for (elt = unwind_protect_list; elt; elt = elt->head.next)
+      procenv_release (elt);
   unwind_protect_list = (UNWIND_ELT *)NULL;
 }
 
@@ -322,6 +340,8 @@
 	{
 	  if (elt->head.cleanup == (Function *) restore_variable)
 	    restore_variable (&elt->sv.v);
+	  else if (elt->head.cleanup == (Function *) restore_procenv)
+	    restore_procenv (&elt->sv.v);
 	  else
 	    (*(elt->head.cleanup)) (elt->arg.v);
 	}
@@ -353,6 +373,42 @@
   unwind_protect_list = elt;
 }
 
+/* Nimbus: a procenv_t saved as unwind_protect_mem_internal saves a variable,
+   copied in and out through nimbus_procenv_copy. */
+static void
+unwind_protect_procenv_internal (var, ignore)
+     char *var;
+     char *ignore;
+{
+  int allocated;
+  UNWIND_ELT *elt;
+
+  allocated = sizeof (procenv_t) + offsetof (UNWIND_ELT, sv.v.desired_setting[0]);
+  if (allocated < sizeof (UNWIND_ELT))
+    allocated = sizeof (UNWIND_ELT);
+  elt = (UNWIND_ELT *)xmalloc (allocated);
+  elt->head.next = unwind_protect_list;
+  elt->head.cleanup = (Function *) restore_procenv;
+  elt->sv.v.variable = var;
+  elt->sv.v.size = sizeof (procenv_t);
+  nimbus_procenv_copy (elt->sv.v.desired_setting, var);
+  unwind_protect_list = elt;
+}
+
+static void
+restore_procenv (sv)
+     SAVED_VAR *sv;
+{
+  nimbus_procenv_copy (sv->variable, sv->desired_setting);
+}
+
+void
+unwind_protect_procenv (var)
+     char *var;
+{
+  without_interrupts (unwind_protect_procenv_internal, var, (char *)NULL);
+}
+
 /* Save the value of a variable so it will be restored when unwind-protects
    are run.  VAR is a pointer to the variable.  SIZE is the size in
    bytes of VAR.  */

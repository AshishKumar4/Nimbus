@@ -47,6 +47,9 @@
 #define unwind_protect_short	unwind_protect_var
 #define unwind_protect_string	unwind_protect_var
 #define unwind_protect_pointer	unwind_protect_var
-#define unwind_protect_jmp_buf	unwind_protect_var
+/* Nimbus: a saved procenv_t is copied in and out through nimbus_procenv_copy,
+   and dropped when its element goes (unwind_prot.c). */
+extern void unwind_protect_procenv PARAMS((char *));
+#define unwind_protect_jmp_buf(X)	unwind_protect_procenv ((char *)(X))
 
 #endif /* _UNWIND_PROT_H */

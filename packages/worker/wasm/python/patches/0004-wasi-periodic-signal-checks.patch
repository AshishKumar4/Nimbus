Nimbus: CPython's Emscripten signal hooks, on for WASI.

At RESUME_CHECK and every eval-breaker check, CPython counts down a clock
and, at zero, checks for a signal the embedder holds for it
(_Py_CheckEmscriptenSignalsPeriodically). On WASI the hooks were empty,
so nothing reached a computing interpreter. The Nimbus build defines them
(nimbus-signal-check.c), and PyErr_CheckSignals counts down the same clock,
since a check costs the host a turn of its event loop.

--- a/Include/internal/pycore_emscripten_signal.h
+++ b/Include/internal/pycore_emscripten_signal.h
@@ -1,7 +1,7 @@
 #ifndef Py_EMSCRIPTEN_SIGNAL_H
 #define Py_EMSCRIPTEN_SIGNAL_H
 
-#if defined(__EMSCRIPTEN__)
+#if defined(__EMSCRIPTEN__) || defined(__wasi__)
 
 #ifndef Py_BUILD_CORE
 #  error "this header requires Py_BUILD_CORE define"
@@ -13,7 +13,13 @@ _Py_CheckEmscriptenSignals(void);
 void
 _Py_CheckEmscriptenSignalsPeriodically(void);
 
+#if defined(__wasi__)
+/* Nimbus: a check asks the host for the process's signals, which costs the
+   host a turn of its event loop, so an immediate check counts down too. */
+#define _Py_CHECK_EMSCRIPTEN_SIGNALS() _Py_CheckEmscriptenSignalsPeriodically()
+#else
 #define _Py_CHECK_EMSCRIPTEN_SIGNALS() _Py_CheckEmscriptenSignals()
+#endif
 
 #define _Py_CHECK_EMSCRIPTEN_SIGNALS_PERIODICALLY() _Py_CheckEmscriptenSignalsPeriodically()
 
@@ -25,6 +31,6 @@ extern int _Py_emscripten_signal_clock;
 #define _Py_CHECK_EMSCRIPTEN_SIGNALS()
 #define _Py_CHECK_EMSCRIPTEN_SIGNALS_PERIODICALLY()
 
-#endif // defined(__EMSCRIPTEN__)
+#endif // defined(__EMSCRIPTEN__) || defined(__wasi__)
 
 #endif // ndef Py_EMSCRIPTEN_SIGNAL_H
--- a/Python/bytecodes.c
+++ b/Python/bytecodes.c
@@ -185,7 +185,7 @@ dummy_func(
         }
 
         inst(RESUME_CHECK, (--)) {
-#if defined(__EMSCRIPTEN__)
+#if defined(__EMSCRIPTEN__) || defined(__wasi__)
             DEOPT_IF(_Py_emscripten_signal_clock == 0);
             _Py_emscripten_signal_clock -= Py_EMSCRIPTEN_SIGNAL_HANDLING;
 #endif
@@ -4387,7 +4387,7 @@ dummy_func(
         /* Progress is guaranteed if we DEOPT on the eval breaker, because
          * ENTER_EXECUTOR will not re-enter tier 2 with the eval breaker set. */
         tier2 op(_TIER2_RESUME_CHECK, (--)) {
-#if defined(__EMSCRIPTEN__)
+#if defined(__EMSCRIPTEN__) || defined(__wasi__)
             DEOPT_IF(_Py_emscripten_signal_clock == 0);
             _Py_emscripten_signal_clock -= Py_EMSCRIPTEN_SIGNAL_HANDLING;
 #endif
--- a/Python/executor_cases.c.h
+++ b/Python/executor_cases.c.h
@@ -13,7 +13,7 @@
         }
 
         case _RESUME_CHECK: {
-            #if defined(__EMSCRIPTEN__)
+            #if defined(__EMSCRIPTEN__) || defined(__wasi__)
             if (_Py_emscripten_signal_clock == 0) {
                 UOP_STAT_INC(uopcode, miss);
                 JUMP_TO_JUMP_TARGET();
@@ -4461,7 +4461,7 @@
         }
 
         case _TIER2_RESUME_CHECK: {
-            #if defined(__EMSCRIPTEN__)
+            #if defined(__EMSCRIPTEN__) || defined(__wasi__)
             if (_Py_emscripten_signal_clock == 0) {
                 UOP_STAT_INC(uopcode, miss);
                 JUMP_TO_JUMP_TARGET();
--- a/Python/generated_cases.c.h
+++ b/Python/generated_cases.c.h
@@ -5193,7 +5193,7 @@
             next_instr += 1;
             INSTRUCTION_STATS(RESUME_CHECK);
             static_assert(0 == 0, "incorrect cache size");
-            #if defined(__EMSCRIPTEN__)
+            #if defined(__EMSCRIPTEN__) || defined(__wasi__)
             DEOPT_IF(_Py_emscripten_signal_clock == 0, RESUME);
             _Py_emscripten_signal_clock -= Py_EMSCRIPTEN_SIGNAL_HANDLING;
             #endif

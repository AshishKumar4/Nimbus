{
  "name": "@nimbus-sh/config",
  "version": "0.3.3",
  "description": "Typed wrangler-config helper for Nimbus embedders. Generates a valid wrangler.jsonc from one function call.",
  "keywords": [
    "cloudflare",
    "workers",
    "wrangler",
    "config",
    "sandbox"
  ],
  "homepage": "https://github.com/AshishKumar4/Nimbus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshishKumar4/Nimbus.git",
    "directory": "packages/config"
  },
  "bugs": "https://github.com/AshishKumar4/Nimbus/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sandbox": {
      "workspace": "./src/sandbox.ts",
      "types": "./dist/sandbox.d.ts",
      "import": "./dist/sandbox.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "prebuild": "bun scripts/generate-facet-limits.mjs",
    "build": "node ../../scripts/clean-dist.mjs && tsrs -p tsconfig.json --noCheck --noEmit false --declaration true --declarationMap true --outDir dist --rootDir src",
    "prepublishOnly": "bun ../../scripts/dist-integrity.mjs --publish",
    "typecheck": "tsrs --noEmit"
  },
  "devDependencies": {
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  },
  "publishConfig": {
    "access": "public"
  }
}

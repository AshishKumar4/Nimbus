{
  "name": "@nimbus-sh/sdk",
  "version": "0.12.0",
  "description": "Nimbus SDK \u2014 Worker embedder, programmatic sandboxes, token mint, and client helpers.",
  "keywords": [
    "cloudflare",
    "workers",
    "durable-objects",
    "sandbox",
    "sdk",
    "code-execution"
  ],
  "homepage": "https://github.com/AshishKumar4/Nimbus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshishKumar4/Nimbus.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/AshishKumar4/Nimbus/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "workspace": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./token": {
      "workspace": "./src/token.ts",
      "types": "./dist/token.d.ts",
      "import": "./dist/token.js"
    },
    "./session": {
      "workspace": "./src/session.ts",
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./sandbox": {
      "workspace": "./src/sandbox.ts",
      "types": "./dist/sandbox.d.ts",
      "import": "./dist/sandbox.js"
    },
    "./flue": {
      "workspace": "./src/flue.ts",
      "types": "./dist/flue.d.ts",
      "import": "./dist/flue.js"
    },
    "./worker": {
      "workspace": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./oauth": {
      "workspace": "./src/oauth.ts",
      "types": "./dist/oauth.d.ts",
      "import": "./dist/oauth.js"
    },
    "./errors": {
      "workspace": "./src/errors.ts",
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./entrypoints": {
      "workspace": "./src/entrypoints.ts",
      "types": "./dist/entrypoints.d.ts",
      "import": "./dist/entrypoints.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json --noCheck --noEmit false --declaration true --declarationMap true --outDir dist --rootDir src",
    "prepublishOnly": "bun ../../scripts/dist-integrity.mjs --publish",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@nimbus-sh/core": "^0.16.0",
    "@nimbus-sh/worker": "^0.14.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@nimbus-sh/worker": "^0.14.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nimbus-sh/config": "^0.2.4",
    "@nimbus-sh/platform": "^0.8.0",
    "zod": "^4.4.3",
    "@nimbus-sh/core": "^0.16.0"
  }
}

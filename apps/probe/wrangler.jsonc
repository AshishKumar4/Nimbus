{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Authenticated probe target for tests/behavioral. CI and local runs
  // point BASE at this Worker so the public hosted demo can stay behind
  // interactive Cloudflare login. Auth is the core JWT mode: set the
  // secret once with `wrangler secret put JWT_SECRET` and mint run
  // tokens with `tests/behavioral/_mint-probe-token.mjs`.
  "name": "nimbus-probe",
  "main": "src/index.ts",
  // Same date as apps/hosted-demo, for the same reasons: the newest the
  // pinned workerd accepts, past `enhanced_error_serialization` (2026-04-21),
  // and past `nodejs_compat` becoming the default (2026-08-04).
  "compatibility_date": "2026-09-26",
  // Shell commands run in the session DO; the 30 s default kills them. Facets keep their own ~30 s.
  "limits": { "cpu_ms": 300000 },
  // Traces on every invocation: throwaways and nimbus-probe-staging are where
  // a lost supervisor call is diagnosed (see apps/hosted-demo/wrangler.jsonc).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "preview_urls": false,
  "vars": {
    // The SHA-256 of the runtime catalog in the NIMBUS_RUNTIME_CACHE bucket below:
    // `nimbus install` reads catalog/sha256/<this>.json and nothing else
    // (packages/worker/src/runtime/runtime-catalog.ts). Written by
    // packages/worker/scripts/bundle-runtime.mjs into every vars block here;
    // vars do not inherit, so each environment states its own.
    "NIMBUS_RUNTIME_CATALOG_SHA256": "11b4b6b174e87c044734207d7c8cd40a412a670e477cc99299e347559f8756fb",
    // Where every resident process in this deployment runs: "facet" (a child
    // actor of the user's own session DO) or "peer" (a child actor of a
    // sibling DO — CPU independence at ~20x the spawn cost). One value for the
    // whole deployment; nothing per-process chooses. See
    // packages/worker/src/loaders/process-host.ts.
    "NIMBUS_PROCESS_HOST": "facet",
    // Same public OAuth client as the hosted demo so the session agent
    // surface (and its probes) behave identically here. Client id and
    // scopes are public PKCE values, not secrets.
    "NIMBUS_AGENT_MODEL": "@cf/zai-org/glm-5.2",
    "NIMBUS_AGENT_GATEWAY_ID": "default",
    "NIMBUS_AGENT_REQUIRE_USER_OAUTH": "1",
    "NIMBUS_CF_OAUTH_CLIENT_ID": "d83b17ca04594b7860f66ab64c9e1ffc",
    "NIMBUS_CF_OAUTH_SCOPES": "user-details.read account-settings.read ai.write aig.run"
  },
  "assets": {
    "directory": "node_modules/@nimbus-sh/worker/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*", "/new"]
  },
  "alias": {
    // Same workspace-local alias set as apps/hosted-demo: these
    // dependencies are installed under the @nimbus-sh/worker workspace
    // package, not hoisted to the repo root.
    "clean-git-ref": "./node_modules/@nimbus-sh/worker/node_modules/clean-git-ref/lib/index.js",
    "is-git-ref-name-valid": "./node_modules/@nimbus-sh/worker/node_modules/is-git-ref-name-valid/index.js",
    "crc-32": "./node_modules/@nimbus-sh/worker/node_modules/crc-32",
    "sha.js": "./node_modules/@nimbus-sh/worker/node_modules/sha.js",
    "pako": "./node_modules/@nimbus-sh/worker/node_modules/pako",
    "pify": "./node_modules/@nimbus-sh/worker/node_modules/pify",
    "diff": "./node_modules/@nimbus-sh/worker/node_modules/diff",
    "diff3": "./node_modules/@nimbus-sh/worker/node_modules/diff3",
    "ignore": "./node_modules/@nimbus-sh/worker/node_modules/ignore",
    "readable-stream": "./node_modules/@nimbus-sh/worker/node_modules/readable-stream",
    "simple-get": "./node_modules/@nimbus-sh/worker/node_modules/simple-get",
    "minimisted": "./node_modules/@nimbus-sh/worker/node_modules/minimisted"
  },
  "durable_objects": {
    "bindings": [
      { "name": "NIMBUS_SESSION", "class_name": "NimbusSession" },
      { "name": "NIMBUS_PUBLIC_DIRECTORY", "class_name": "NimbusPublicDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NimbusSession"] },
    { "tag": "v2", "new_sqlite_classes": ["NimbusPublicDirectory"] }
  ],
  "worker_loaders": [
    { "binding": "LOADER" }
  ],
  "r2_buckets": [
    {
      "binding": "NPM_TARBALL_CACHE",
      "bucket_name": "nimbus-npm-cache"
    },
    {
      "binding": "NPM_PACKUMENT_CACHE",
      "bucket_name": "nimbus-npm-packument-cache"
    },
    {
      "binding": "NIMBUS_RUNTIME_CACHE",
      "bucket_name": "nimbus-runtime-cache"
    }
  ],
  // Worker Previews (`wrangler preview`, wrangler >= 4.135): what every
  // throwaway probe target — local `_throwaway-target.mjs up` and CI's
  // `nimbus-tw-ci-*` — runs as. A Preview inherits NO binding or var from
  // the top level (https://developers.cloudflare.com/workers/previews/configuration/),
  // so each one is redeclared here with the same name. Durable Objects get
  // a namespace and SQLite storage of their own per Preview, automatically;
  // the three R2 caches are the same shared-by-design buckets the top level
  // binds (scripts/deploy-isolation.mjs holds a Preview to that list). No
  // secret lives here: JWT_SECRET is generated per Preview and uploaded
  // with its deployment (`--secrets-file`, `--ignore-base-config`).
  "previews": {
    "vars": {
      "NIMBUS_RUNTIME_CATALOG_SHA256": "11b4b6b174e87c044734207d7c8cd40a412a670e477cc99299e347559f8756fb",
      "NIMBUS_PROCESS_HOST": "facet",
      "NIMBUS_AGENT_MODEL": "@cf/zai-org/glm-5.2",
      "NIMBUS_AGENT_GATEWAY_ID": "default",
      "NIMBUS_AGENT_REQUIRE_USER_OAUTH": "1",
      "NIMBUS_CF_OAUTH_CLIENT_ID": "d83b17ca04594b7860f66ab64c9e1ffc",
      "NIMBUS_CF_OAUTH_SCOPES": "user-details.read account-settings.read ai.write aig.run"
    },
    "durable_objects": {
      "bindings": [
        { "name": "NIMBUS_SESSION", "class_name": "NimbusSession" },
        { "name": "NIMBUS_PUBLIC_DIRECTORY", "class_name": "NimbusPublicDirectory" }
      ]
    },
    "worker_loaders": [
      { "binding": "LOADER" }
    ],
    "r2_buckets": [
      { "binding": "NPM_TARBALL_CACHE", "bucket_name": "nimbus-npm-cache" },
      { "binding": "NPM_PACKUMENT_CACHE", "bucket_name": "nimbus-npm-packument-cache" },
      { "binding": "NIMBUS_RUNTIME_CACHE", "bucket_name": "nimbus-runtime-cache" }
    ]
  }
}

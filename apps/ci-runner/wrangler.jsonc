{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The unit suite on Cloudflare Containers: one CiRun Durable Object per run,
  // one CiShard (and its container) per shard. See src/index.ts. Deploy with
  // `bun apps/ci-runner/scripts/deploy.mjs`, which stages the image context.
  "name": "nimbus-ci-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "CiShard",
      // Built from .image-context/, which scripts/deploy.mjs stages: the
      // Dockerfile, the shard driver, and main's manifests for the bun cache.
      "image": "./.image-context/Dockerfile",
      "image_build_context": "./.image-context",
      // 4 vCPU, 12 GiB, 20 GB: the largest instance. A shard runs 4 files at once.
      "instance_type": "standard-4",
      "max_instances": 60,
      // A deploy rolls the image out to every instance. A shard that is
      // running keeps its container for up to an hour first, so a deploy
      // never cuts a run short (one did, before this was set).
      "rollout_active_grace_period": 3600
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CI_RUN", "class_name": "CiRun" },
      { "name": "CI_SHARD", "class_name": "CiShard" },
      { "name": "CI_TIMINGS", "class_name": "CiTimings" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CiRun", "CiShard"] },
    { "tag": "v2", "new_sqlite_classes": ["CiTimings"] }
  ],
  // Commit archives, shard logs and reports. A 7-day lifecycle rule on the
  // bucket expires them; the timing history lives in CiTimings.
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "nimbus-ci-artifacts" }]
}

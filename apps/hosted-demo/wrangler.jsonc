{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Three tiers, three disjoint sets of account-level resources:
  //
  //   top level    → `nimbus-dev` / `nimbus-demo-dev` / rate-limit 1002.
  //                  DEVELOPMENT, and the block a `--name` override
  //                  inherits, so a throwaway lands here by default.
  //   env.staging  → `nimbus-staging` / `nimbus-demo-staging` / 1003.
  //                  Persistent pre-production. `bun run staging:deploy`.
  //   env.production → `nimbus` / `nimbus-demo` / 1001. `bun run
  //                  deploy:production` (`wrangler deploy -e production`),
  //                  and nothing else.
  //
  // The split is load-bearing, not tidiness. `wrangler deploy --name foo`
  // overrides ONLY the name; every binding still comes from the block being
  // deployed. While this block held the production `database_id`, two
  // separate throwaway probes — one hand-rolled from this directory, one a
  // copy of this file with `env` stripped out — silently read and wrote the
  // live demo D1 while appearing isolated, and burned DEMO_ANON_MAX_ACTIVE
  // slots away from the public docs terminal. Anything inheriting this
  // block now lands on development resources instead.
  //
  // tests/unit/deploy-isolation.mjs enforces this in CI: it fails if a
  // non-production deploy resolves any resource env.production also binds.
  "name": "nimbus-dev",
  // The hosted-demo embedder is the live demo at nimbus-os.dev
  // and serves as the canonical reference embedder for the SDK.
  // The small src/index.ts here re-exports from @nimbus-sh/sdk/worker
  // — exactly the shape a third-party embedder ships.
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  // [DEPLOY-FLAG-FIX 2026-05-08] Removed `experimental` and `replica_routing`.
  //
  // Both flags are tagged `$experimental` in workerd
  // (src/workerd/io/compatibility-date.capnp:replicaRouting@60 +
  //  workerdExperimental@24); per the same file's `experimental`
  // annotation: "Experimental flags cannot be used in Workers
  // deployed on Cloudflare except by test accounts belonging to
  // Cloudflare team members." The platform validator started
  // enforcing this for our account between the 2026-05-08T19:19Z
  // deploy (succeeded) and 21:43Z deploy (rejected with [code: 10021]).
  // Same wrangler.jsonc, same wrangler 4.80.0 — server-side change.
  //
  // Runtime evidence both flags are dead config from Nimbus's POV:
  //
  //   `experimental`: the workerd source comment ("catch-all
  //   compatibility flag for experimental development... do not
  //   ignore this warning") describes its actual role as gating
  //   `allowExperimental: true` on child Worker Loaders
  //   (src/workerd/api/worker-loader.c++:267-274). `grep
  //   "allowExperimental" packages/worker/src/` finds zero call sites —
  //   Nimbus only declares the field in packages/worker/src/loaders/vendor/types.ts
  //   for type-shape parity with the upstream cloudflare-parallel
  //   library, never sets it. The ctx.exports loopback bindings
  //   (NimbusLoaderRPC, NimbusAssetsRPC, etc.) work via
  //   `enable_ctx_exports` which is implied by the 2026-04-01
  //   compatibility_date.
  //
  //   `replica_routing`: enables a runtime-side opt-in for DO read
  //   replica routing. packages/worker/src/replica/routing.ts::tryEnableReplicas
  //   probes `ctx.storage.enableReplicas()` and
  //   `ctx.storage.configureReadReplication()`; both throw or
  //   return undefined when the platform-side feature is
  //   unavailable. The probe catches and returns
  //   `state: 'unsupported'`, exposed via /api/_diag/replica-routing.
  //   Without the flag, runtime code paths land on this graceful
  //   fallback: DOs continue serving requests through the single-primary
  //   storage path.
  //
  // Both top-level and
  // env.production now carry the same `compatibility_flags`.
  // Note (pyodide-v2): the `allow_eval_during_startup` flag — which
  // relaxes the CSP blocking `new WebAssembly.Module(rawBytes)` at
  // module-init time and is required by Pyodide's convertJsFunctionToWasm
  // (called from addFunction → reportUndefinedSymbols → loadDylibs →
  // receiveInstance) — became the default as of 2025-06-01. Our
  // compatibility_date above (2026-04-01) is past that, so the flag is
  // implicitly enabled and MUST NOT be listed here (wrangler validator
  // rejects redundant flags). See smoketest-result.md for the
  // empirical chain that established this.
  "compatibility_flags": ["nodejs_compat"],
  // BUILD NOTHING ON VERSIONED PREVIEW URLS until someone produces one
  // that resolves. Measured 2026-08-05, wrangler 4.98.0, on
  // `nimbus-staging` — `preview_urls` and `workers_dev` both on, the most
  // favourable case available:
  //   - `wrangler deploy` printed the workers.dev URL and `Current
  //     Version ID` and nothing else; `wrangler versions upload` printed
  //     only `Worker Version ID`. Neither printed a preview URL.
  //   - `<version-prefix>-nimbus-staging.<subdomain>.workers.dev` 404s
  //     for a version id that demonstrably exists — as does the same
  //     shape against the production Worker's live version.
  // The key stays because removing it can only make previews less
  // available (wrangler 4.44+ disables them by default:
  // https://developers.cloudflare.com/changelog/2025-09-17-update-preview-url-setting/).
  // That is a conservative default, NOT evidence that previews work.
  //
  // Read the above before writing a fifth wrong thing here. The comment
  // this replaced claimed the URL was `<VERSION_PREFIX>-nimbus-os.dev`
  // and that previews were safe in prod because only someone holding the
  // prefix could resolve one. Three agents in a row acted on it. Measured
  // 2026-08-04: `<anything>-nimbus-os.dev` is NXDOMAIN — a hyphen where a
  // subdomain needs a dot, so it was never a host — while
  // `deadbeef.nimbus-os.dev` and `zzzznope.nimbus-os.dev` BOTH resolve
  // and BOTH answer 200, because the `*.nimbus-os.dev/*` route below
  // hands every subdomain to the production Worker. DNS obscurity was
  // never the protection.
  //
  // What keeps a test off production is the DEPLOY TARGET, not the
  // hostname. `wrangler versions upload -e production` and `wrangler
  // deploy -e production` both act on the Worker named `nimbus`: the
  // first appends to the live script's version list, the second shifts
  // its traffic. Neither is made safe by visiting some URL afterwards.
  // Isolation is a distinct Worker name — `nimbus-staging` (env.staging),
  // `nimbus-probe-staging`, or a `nimbus-tw-*` throwaway. See AGENTS.md
  // § Staging And Promote.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "preview_urls": true,
  // [W12 — Lever 7 / G4] Smart Placement on the gateway Worker. Per
  // [docs](https://developers.cloudflare.com/workers/configuration/placement/),
  // Cloudflare measures the Worker's request duration in different colos
  // and pins it to the optimum (≤15 min analysis window post-deploy).
  // ⚠️ Smart Placement is "ignored when making RPC calls" per
  // [Workers RPC docs](https://developers.cloudflare.com/workers/runtime-apis/rpc/),
  // so RPC into the DO is unchanged — but the gateway's own fetch handler
  // gets pinned near the DO's region, which removes the cross-region
  // gateway⇄DO RTT for warm tenants. DOs themselves don't move
  // (CF research §J.9). Trade-off: with `run_worker_first: true` EVERY
  // request runs at the placed colo, including the marketing page and
  // `/docs/*`, whose ASSETS fetches used to be served direct-from-edge —
  // they now round-trip to the placement, unmitigated, and that cost is
  // paid by exactly the visitors furthest from it. Host-based preview
  // routing needs the Worker on every request, so the two cannot both be
  // had; re-evaluate if landing-page TTFB regresses.
  // See W12-plan.md §4.3.
  // `placement` is an inheritable key — env.production picks it up
  // automatically from the top level.
  "placement": { "mode": "smart" },
  "vars": {
    // Diagnostic gate for [sqlite-vfs/W2.5b] logs. Set to "1" to enable;
    // empty/absent disables. The diag code remains in
    // packages/worker/src/vfs/sqlite-vfs.ts
    // (cheap, hot-path-clean) for future investigations.
	    "NIMBUS_DIAG_INSTALL_PIPELINE": "",
	    // Where every resident process in this deployment runs: "facet" (a
	    // child actor of the user's own session DO) or "peer" (a child actor
	    // of a sibling DO — CPU independence at ~20x the spawn cost). One
	    // value for the whole deployment; nothing per-process chooses. See
	    // packages/worker/src/loaders/process-host.ts.
	    "NIMBUS_PROCESS_HOST": "facet",
	    "NIMBUS_AGENT_MODEL": "@cf/zai-org/glm-5.2",
	    "NIMBUS_AGENT_GATEWAY_ID": "default",
	    "NIMBUS_AGENT_REQUIRE_USER_OAUTH": "1",
	    "NIMBUS_CF_OAUTH_CLIENT_ID": "d83b17ca04594b7860f66ab64c9e1ffc",
	    "NIMBUS_CF_OAUTH_SCOPES": "user-details.read account-settings.read ai.write aig.run",
	    "DEMO_SESSION_IDLE_TTL_DAYS": "3",
	    "DEMO_TOUCH_DEBOUNCE_SECONDS": "600",
	    "DEMO_AUTH_COOKIE_DAYS": "30",
	    "DEMO_NIMBUS_JWT_TTL_SECONDS": "900",
	    "DEMO_CLEANUP_BATCH_SIZE": "100",
	    // Ceiling on concurrently live free sandboxes. Sized for `GET /try`
	    // being the landing page's primary call to action, not just the docs
	    // terminal: at the 600s lifetime, 100 slots sustain ~600 starts/hour
	    // before anyone is turned away.
	    "DEMO_ANON_TTL_SECONDS": "600",
	    "DEMO_ANON_MAX_ACTIVE": "100"
	  },
  // Per-IP limiter for both anonymous session entry points
  // (POST /api/demo/anon-session, GET /try). Counters are shared across
  // Workers on the account by namespace_id; period must be 10 or 60
  // (seconds).
  // Distinct namespace from production's 1001: counters are shared across
  // Workers on the account BY namespace_id, so a dev or throwaway sharing it
  // would spend production's per-IP budget for real visitors on that IP.
  "ratelimits": [
    {
      "name": "ANON_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "assets": {
    // dist/assets is assembled by scripts/build-assets.mjs (run by the
    // predev/predeploy hooks): the @nimbus-sh/worker/public shell assets
    // plus the apps/docs build mounted at /docs. A Worker gets exactly one
    // assets binding, so both ship as one directory.
    "directory": "dist/assets",
    "binding": "ASSETS",
    // The Worker sees every request and decides: a port-preview host
    // (`<port>--<sid>.<suffix>`) forwards to the session, session routes
    // forward to the DO, everything else falls through to env.ASSETS.
    // `run_worker_first` only matches PATHS, and a previewed app owns its
    // whole path space — with a path allowlist an app's `/`, `/favicon.ico`
    // or `/assets/*` would be shadowed by this Worker's own static files
    // (the landing page was served instead of the app, so the preview
    // token exchange at `/` never ran). Host-based routing therefore
    // requires worker-first for everything; the router's final fallthrough
    // serves assets explicitly. The router enforces the other half of
    // "the app owns its path space": on a preview host it answers with the
    // port forward and nothing else — no `/login`, no `/new`, no `/s/*`.
	    "run_worker_first": true
	  },
  "alias": {
    // Hosted demo runs from a Bun workspace app. These dependencies are
    // installed under the @nimbus-sh/worker workspace package, not hoisted
    // to the repo root, so use concrete local paths here. External
    // scaffolded projects can use the package-name aliases generated by
    // @nimbus-sh/config.
    "clean-git-ref": "./node_modules/@nimbus-sh/worker/node_modules/clean-git-ref/lib/index.js",
    "is-git-ref-name-valid": "./node_modules/@nimbus-sh/worker/node_modules/is-git-ref-name-valid/index.js",
    "crc-32": "./node_modules/@nimbus-sh/worker/node_modules/crc-32",
    "sha.js": "./node_modules/@nimbus-sh/worker/node_modules/sha.js",
    "pako": "./node_modules/@nimbus-sh/worker/node_modules/pako",
    "pify": "./node_modules/@nimbus-sh/worker/node_modules/pify",
    "diff": "./node_modules/@nimbus-sh/worker/node_modules/diff",
    "diff3": "./node_modules/@nimbus-sh/worker/node_modules/diff3",
    "ignore": "./node_modules/@nimbus-sh/worker/node_modules/ignore",
    "readable-stream": "./node_modules/@nimbus-sh/worker/node_modules/readable-stream",
    "simple-get": "./node_modules/@nimbus-sh/worker/node_modules/simple-get",
    "minimisted": "./node_modules/@nimbus-sh/worker/node_modules/minimisted"
  },
	  "durable_objects": {
	    "bindings": [
	      { "name": "NIMBUS_SESSION", "class_name": "NimbusSession" }
	    ]
	  },
	  // Development database, carrying the same migrations as production.
	  // `wrangler dev` simulates D1 locally and never contacts this id, so
	  // its real purpose is to be the thing a throwaway inherits instead of
	  // production. The production database is named only in env.production.
	  "d1_databases": [
	    {
	      "binding": "DEMO_DB",
	      "database_name": "nimbus-demo-dev",
	      "database_id": "72d98818-359a-4c30-ba59-e3f4418bfa74"
	    }
	  ],
	  "migrations": [
	    { "tag": "v1", "new_sqlite_classes": ["NimbusSession"] }
	  ],
	  "worker_loaders": [
	    { "binding": "LOADER" }
	  ],
	  "triggers": {
	    // Every 10 minutes: anonymous docs-terminal sessions live ~10 min
	    // (DEMO_ANON_TTL_SECONDS); an hourly sweep would let their DOs
	    // overstay the TTL by up to 6x. The cleanup scan is a cheap indexed
	    // D1 SELECT, so the extra cadence costs nothing when idle.
	    "crons": ["*/10 * * * *"]
	  },
  // R2-backed cross-tenant npm cache.
  //
  // Two buckets:
  //   - nimbus-npm-cache:           tarballs, content-fixed, immutable.
  //                                 No TTL, schema-bump invalidation only.
  //   - nimbus-npm-packument-cache: packument JSON, 5-min TTL via
  //                                 customMetadata.expiresAt.
  //
  // Graceful-degrade: if these bindings are missing at runtime, the
  // R2CacheClient treats reads as misses and writes
  // as no-ops. The installer falls through to its existing
  // registry.npmjs.org fetch path with no behavioural change. So this
  // config is safe to land BEFORE the R2 buckets are provisioned in
  // the production CF account.
  //
  // To provision (one-time, manual):
  //   wrangler r2 bucket create nimbus-npm-cache
  //   wrangler r2 bucket create nimbus-npm-packument-cache
  //
  // No `preview_bucket_name`: the same buckets are used in dev. With
  // `wrangler dev` (local), the binding falls through to the local R2
  // simulator which is empty — same null-bucket null-on-miss path.
  "r2_buckets": [
    {
      "binding": "NPM_TARBALL_CACHE",
      "bucket_name": "nimbus-npm-cache"
    },
    {
      "binding": "NPM_PACKUMENT_CACHE",
      "bucket_name": "nimbus-npm-packument-cache"
    },
    {
      // Runtime package manager cache. Stores content-addressed runtime blobs,
      // per-version manifests, and the catalog under `blobs/`, `manifests/`,
      // and `catalog/v1.json`.
      "binding": "NIMBUS_RUNTIME_CACHE",
      "bucket_name": "nimbus-runtime-cache"
    }
  ],
  // [DEPLOY-FLAG-FIX 2026-05-08] env.production overlay no longer
  // carries any flags the top-level doesn't. Pre-fix it held
  // `replica_routing` (CWB-1 hotfix). With that flag now removed at
  // both layers, the env overlay's only role is to redeclare
  // non-inheritable bindings (vars, durable_objects, r2_buckets,
  // worker_loaders) so they reach the deployed Worker.
  //
  // Wrangler env-overlay rules:
  // - **Inheritable keys** (`compatibility_date`, `placement`,
  //   `assets`, `alias`, `worker_loaders` *), `main`, `name`,
  //   `compatibility_flags`): if absent in env block, inherited from
  //   top level. If present, the env value REPLACES the top-level
  //   value entirely (no merge for array fields).
  // - **Non-inheritable keys** (`vars`, `durable_objects`,
  //   `r2_buckets`, `kv_namespaces`, `services`, etc.): MUST be
  //   redeclared in the env block to reach the deployed Worker. Verified
  //   per https://developers.cloudflare.com/workers/wrangler/configuration/#non-inheritable-keys
  // - **Top-level only keys** (`migrations`): cannot appear in env
  //   blocks; `migrations` is shared across all envs by definition.
  //
  // *) Note: `worker_loaders` was originally treated as inheritable,
  // but `wrangler deploy -e production --dry-run` warns that it is
  // not actually inherited at deploy time and recommends
  // redeclaration in env.production. Done below.
  //
  // The `name` field is duplicated explicitly so the deployed Worker
  // is `nimbus`, not `nimbus-production` (wrangler's default behavior
  // is to append the env name unless `name` is explicitly set in the
  // env block).
  "env": {
    // Persistent pre-production mirror. Same `main`, same `dist/assets`,
    // same inherited `placement`/`alias`/`compatibility_date` as
    // env.production, with every account-level identifier swapped: Worker
    // `nimbus-staging`, database `nimbus-demo-staging`, rate-limit
    // namespace 1003, and its own Durable Object namespace and
    // JWT_SECRET. `bun run staging:deploy` builds and deploys it; `bun
    // run staging:test` runs the behavioral suite against it. Nothing
    // here may name a production resource — tests/unit/deploy-isolation.mjs
    // checks this block by name, not just the top-level one.
    //
    // Two deliberate divergences from production, both structural rather
    // than chosen:
    //
    //   No `routes`. Staging answers on workers.dev, so it needs no zone
    //   and no DNS record, and it cannot collide with the wildcard route
    //   that serves live traffic.
    //
    //   No `NIMBUS_PREVIEW_HOST_SUFFIX`. Port previews need one hostname
    //   per (session, port) — `<port>--<sid>.<suffix>` — which requires a
    //   wildcard DNS record on a zone. workers.dev gives a Worker exactly
    //   one hostname, so the suffix is left unset and `readPreviewHostSuffix`
    //   degrades to previews-disabled (packages/worker/src/_shared/preview-host.ts).
    //   Path-based `/s/<sid>/port/<n>/` — what the behavioral driver
    //   uses — is unaffected. Host-based previews are therefore verified
    //   on prod's zone or a throwaway with a zone route, not here.
    "staging": {
      "name": "nimbus-staging",
      "compatibility_flags": ["nodejs_compat"],
      "preview_urls": true,
      "workers_dev": true,
      "vars": {
        "NIMBUS_DIAG_INSTALL_PIPELINE": "",
        // Staging is the test environment, which is exactly what the debug
        // gate exists to distinguish: diag write surfaces (cache/telemetry
        // reset) answer here and stay 404 on production.
        "NIMBUS_DEBUG": "1",
        "NIMBUS_PROCESS_HOST": "facet",
        "NIMBUS_AGENT_MODEL": "@cf/zai-org/glm-5.2",
        "NIMBUS_AGENT_GATEWAY_ID": "default",
        "NIMBUS_AGENT_REQUIRE_USER_OAUTH": "1",
        "NIMBUS_CF_OAUTH_CLIENT_ID": "d83b17ca04594b7860f66ab64c9e1ffc",
        "NIMBUS_CF_OAUTH_SCOPES": "user-details.read account-settings.read ai.write aig.run",
        "DEMO_SESSION_IDLE_TTL_DAYS": "3",
        "DEMO_TOUCH_DEBOUNCE_SECONDS": "600",
        "DEMO_AUTH_COOKIE_DAYS": "30",
        "DEMO_NIMBUS_JWT_TTL_SECONDS": "900",
        "DEMO_CLEANUP_BATCH_SIZE": "100",
        "DEMO_ANON_TTL_SECONDS": "600",
        "DEMO_ANON_MAX_ACTIVE": "100"
      },
      "ratelimits": [
        {
          "name": "ANON_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 6, "period": 60 }
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "NIMBUS_SESSION", "class_name": "NimbusSession" }
        ]
      },
      "d1_databases": [
        {
          "binding": "DEMO_DB",
          "database_name": "nimbus-demo-staging",
          "database_id": "5589ddb3-96bc-4a73-b939-5431553b63d7"
        }
      ],
      "worker_loaders": [
        { "binding": "LOADER" }
      ],
      "triggers": {
        "crons": ["*/10 * * * *"]
      },
      "r2_buckets": [
        {
          "binding": "NPM_TARBALL_CACHE",
          "bucket_name": "nimbus-npm-cache"
        },
        {
          "binding": "NPM_PACKUMENT_CACHE",
          "bucket_name": "nimbus-npm-packument-cache"
        },
        {
          "binding": "NIMBUS_RUNTIME_CACHE",
          "bucket_name": "nimbus-runtime-cache"
        }
      ]
    },
    "production": {
      "name": "nimbus",
      "compatibility_flags": ["nodejs_compat"],
      "preview_urls": true,
      // Per-port app previews: each exposed session port is served at its own
      // hostname `<port>--<sid>.nimbus-os.dev` so apps that assume a ROOT asset
      // path (`/style.css`, `fetch('/api/..')`) resolve with zero rewriting.
      // custom_domain cannot be a wildcard, so this is a zone route. The worker
      // treats ONLY `^(\d+)--(.+)$` hosts as previews (see
      // src/_shared/preview-host.ts) — the apex, the legacy custom domain, the
      // versioned preview_urls host, and any other subdomain fall through to
      // normal handling. Active: the proxied `*` AAAA record is live on the
      // zone and NIMBUS_PREVIEW_HOST_SUFFIX (below) turns the feature on across
      // worker + shell + SDK. Universal SSL covers `*.nimbus-os.dev`
      // (first-level wildcard), so no certificate step is needed.
      "routes": [
        { "pattern": "nimbus-os.dev", "custom_domain": true },
        { "pattern": "nimbus.ashishkumarsingh.com", "custom_domain": true },
        { "pattern": "*.nimbus-os.dev/*", "zone_name": "nimbus-os.dev" }
      ],
	      "vars": {
	        "NIMBUS_DIAG_INSTALL_PIPELINE": "",
	        "NIMBUS_PROCESS_HOST": "facet",
	        "NIMBUS_AGENT_MODEL": "@cf/zai-org/glm-5.2",
	        "NIMBUS_AGENT_GATEWAY_ID": "default",
	        "NIMBUS_AGENT_REQUIRE_USER_OAUTH": "1",
	        "NIMBUS_CF_OAUTH_CLIENT_ID": "d83b17ca04594b7860f66ab64c9e1ffc",
	        "NIMBUS_CF_OAUTH_SCOPES": "user-details.read account-settings.read ai.write aig.run",
	        "DEMO_SESSION_IDLE_TTL_DAYS": "3",
	        "DEMO_TOUCH_DEBOUNCE_SECONDS": "600",
	        "DEMO_AUTH_COOKIE_DAYS": "30",
	        "DEMO_NIMBUS_JWT_TTL_SECONDS": "900",
	        "DEMO_CLEANUP_BATCH_SIZE": "100",
	        "DEMO_ANON_TTL_SECONDS": "600",
	        "DEMO_ANON_MAX_ACTIVE": "100",
	        "NIMBUS_PREVIEW_HOST_SUFFIX": "nimbus-os.dev"
	      },
      "ratelimits": [
        {
          "name": "ANON_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 6, "period": 60 }
        }
      ],
	      "durable_objects": {
	        "bindings": [
	          { "name": "NIMBUS_SESSION", "class_name": "NimbusSession" }
	        ]
	      },
	      "d1_databases": [
	        {
	          "binding": "DEMO_DB",
	          "database_name": "nimbus-demo",
	          "database_id": "8e2ecc37-d975-49d8-96b7-885d45734a53"
	        }
	      ],
	      "worker_loaders": [
	        { "binding": "LOADER" }
	      ],
	      "triggers": {
	        "crons": ["*/10 * * * *"]
	      },
      "r2_buckets": [
        {
          "binding": "NPM_TARBALL_CACHE",
          "bucket_name": "nimbus-npm-cache"
        },
        {
          "binding": "NPM_PACKUMENT_CACHE",
          "bucket_name": "nimbus-npm-packument-cache"
        },
        {
          "binding": "NIMBUS_RUNTIME_CACHE",
          "bucket_name": "nimbus-runtime-cache"
        }
      ]
    }
  }
}

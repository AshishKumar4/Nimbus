---
import rows from '../data/capabilities.json';

const chip: Record<string, { label: string; kind: string }> = {
	works: { label: 'works', kind: 'works' },
	alpha: { label: 'alpha', kind: 'alpha' },
	no: { label: 'not supported', kind: 'no' },
};
---

<div class="capx" data-capability-explorer>
	<div class="capx-controls">
		<input
			type="search"
			placeholder="Filter capabilities… (e.g. python, git, TTY)"
			data-role="search"
			aria-label="Filter capabilities"
		/>
		<div class="capx-pills" role="group" aria-label="Filter by status">
			<button type="button" data-filter="all" aria-pressed="true">all</button>
			<button type="button" data-filter="works" aria-pressed="false">works</button>
			<button type="button" data-filter="alpha" aria-pressed="false">alpha</button>
			<button type="button" data-filter="no" aria-pressed="false">not supported</button>
		</div>
	</div>
	<ul class="capx-list">
		{
			rows.map((r) => (
				<li data-status={r.status} data-text={`${r.area} ${r.description}`.toLowerCase()}>
					<span class="capx-area">{r.area}</span>
					<span class="capx-cap">{r.description}</span>
					<span class="nimbus-chip" data-kind={chip[r.status].kind}>
						{chip[r.status].label}
					</span>
				</li>
			))
		}
	</ul>
	<p class="capx-empty" data-role="empty" hidden>No capabilities match that filter.</p>
	<p class="capx-note">
		Shares its capability catalog with the <a href="https://github.com/AshishKumar4/Nimbus#what-works-today">README capability table</a>, covered by the behavioral suite in
		<code>tests/behavioral/</code>.
	</p>
</div>

<style>
	.capx {
		margin: 1.5rem 0;
	}
	.capx-controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		align-items: center;
		margin-bottom: 0.9rem;
		padding: 0.7rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--nimbus-panel-radius);
		background: var(--nimbus-panel-bg);
	}
	.capx-controls input {
		flex: 1;
		min-width: min(100%, 16rem);
		font: inherit;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--nimbus-control-radius);
		padding: 0.5rem 0.7rem;
	}
	.capx-controls input::placeholder {
		color: var(--sl-color-gray-3);
	}
	.capx-controls input:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
		border-color: var(--sl-color-accent);
	}
	.capx-pills {
		display: flex;
		gap: 0.35rem;
		flex-wrap: wrap;
	}
	.capx-pills button {
		font-family: var(--sl-font-system-mono);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--sl-color-gray-2);
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--nimbus-control-radius);
		padding: 0.28rem 0.65rem;
		cursor: pointer;
	}
	.capx-pills button:hover {
		border-color: color-mix(in srgb, var(--sl-color-accent) 55%, var(--sl-color-hairline));
	}
	.capx-pills button:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.capx-pills button[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-text-accent);
		background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
	}
	.capx-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.capx-list li {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr) auto;
		gap: 0.7rem;
		align-items: center;
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--nimbus-control-radius);
		padding: 0.6rem 0.75rem;
		background: var(--nimbus-panel-bg);
		font-size: var(--sl-text-sm);
	}
	.capx-area {
		font-family: var(--sl-font-system-mono);
		font-size: 0.66rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--sl-color-gray-3);
	}
	.capx-cap {
		min-width: 0;
		overflow-wrap: anywhere;
		color: var(--sl-color-gray-1);
	}
	.capx-list .nimbus-chip {
		justify-self: end;
	}
	.capx-empty,
	.capx-note {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		margin-top: 0.8rem;
	}
	@media (max-width: 560px) {
		.capx-controls input { width: 100%; }
		.capx-list li {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 0.35rem 0.7rem;
		}
		.capx-area { grid-column: 1; grid-row: 1; }
		.capx-list .nimbus-chip { grid-column: 2; grid-row: 1; }
		.capx-cap { grid-column: 1 / -1; grid-row: 2; }
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-capability-explorer]').forEach((el) => {
		const search = el.querySelector<HTMLInputElement>('[data-role="search"]')!;
		const pills = el.querySelectorAll<HTMLButtonElement>('[data-filter]');
		const items = el.querySelectorAll<HTMLElement>('.capx-list li');
		const empty = el.querySelector<HTMLElement>('[data-role="empty"]')!;
		let status = 'all';

		function apply() {
			const q = search.value.trim().toLowerCase();
			let shown = 0;
			items.forEach((li) => {
				const ok =
					(status === 'all' || li.dataset.status === status) &&
					(!q || (li.dataset.text || '').includes(q));
				li.hidden = !ok;
				if (ok) shown++;
			});
			empty.hidden = shown > 0;
		}

		search.addEventListener('input', apply);
		pills.forEach((p) =>
			p.addEventListener('click', () => {
				status = p.dataset.filter || 'all';
				pills.forEach((b) => b.setAttribute('aria-pressed', String(b === p)));
				apply();
			}),
		);
	});
</script>

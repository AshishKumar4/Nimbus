---
/**
 * PermissionsSeam — the S2 permissions design: a real credential carried
 * to one VFS mutation choke point, which either lands the write or fails
 * with EACCES/EPERM. Design-stage; drawn dashed on purpose.
 */
import Diagram from './Diagram.astro';
interface Props {
	caption?: string;
}
const { caption } = Astro.props;
---

<Diagram
	label="Planned permissions seam: shell, runtime shims, and the WASI host all pass a uid/gid credential to one VFS choke point, which allows the write or returns EACCES"
	caption={caption}
>
	<svg viewBox="0 0 940 310" xmlns="http://www.w3.org/2000/svg">
		<defs>
			<marker id="ps-arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M0,0.6 L7.4,4 L0,7.4 Z" />
			</marker>
			<marker id="ps-arr-a" class="dgm-accent" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M0,0.6 L7.4,4 L0,7.4 Z" />
			</marker>
		</defs>

		<text class="dgtag dgwarn" x="14" y="20">S2 design — not shipped</text>

		<rect class="dgnode" x="14" y="40" width="190" height="52" rx="9" />
		<text class="dgt" x="28" y="62">shell &amp; coreutils</text>
		<text class="dgs" x="28" y="80">rm · mv · chmod</text>

		<rect class="dgnode" x="14" y="120" width="190" height="52" rx="9" />
		<text class="dgt" x="28" y="142">runtime shims</text>
		<text class="dgs" x="28" y="160">node · python · ruby fs</text>

		<rect class="dgnode" x="14" y="200" width="190" height="52" rx="9" />
		<text class="dgt" x="28" y="222">WASI host</text>
		<text class="dgs" x="28" y="240">fd_write · path_open</text>

		<path class="dgedge" d="M 204,66 Q 248,66 266,118 L 274,136" marker-end="url(#ps-arr)" />
		<line class="dgedge" x1="204" y1="146" x2="274" y2="146" marker-end="url(#ps-arr)" />
		<path class="dgedge" d="M 204,226 Q 248,226 266,174 L 274,156" marker-end="url(#ps-arr)" />

		<rect class="dgnode2" x="282" y="114" width="180" height="64" rx="9" />
		<text class="dgt" x="296" y="140">credential</text>
		<text class="dgs" x="296" y="160">uid · gid — per process</text>

		<line class="dgedge" x1="462" y1="146" x2="512" y2="146" marker-end="url(#ps-arr)" />

		<rect class="dghero" x="520" y="114" width="200" height="64" rx="10" />
		<text class="dgt" x="534" y="140">one VFS choke point</text>
		<text class="dgs" x="534" y="160">every mutation passes here</text>

		<path class="dgedge-accent" d="M 720,132 Q 748,124 758,96 L 764,82" marker-end="url(#ps-arr-a)" />
		<path class="dgedge-dashed" d="M 720,160 Q 748,168 758,196 L 764,210" marker-end="url(#ps-arr)" />

		<rect class="dgnode" x="756" y="26" width="168" height="56" rx="9" />
		<text class="dgt dgaccent" x="770" y="48">write lands</text>
		<text class="dgs" x="770" y="68">revision bumps</text>

		<rect class="dgghost" x="756" y="212" width="168" height="56" rx="9" />
		<text class="dgt dgdanger" x="770" y="234">EACCES / EPERM</text>
		<text class="dgnote" x="770" y="254">honest on every runtime</text>

		<text class="dgs" x="282" y="230">today chown and umask are no-ops; this design replaces</text>
		<text class="dgs" x="282" y="250">fake success with real checks. chmod (S1) already shipped.</text>
	</svg>
</Diagram>

---
/**
 * NimbusSandbox — the live terminal on the docs home and quickstart page.
 *
 * Live mode requires `PUBLIC_NIMBUS_ANON_ATTACH_URL` at build time, pointing
 * at the anonymous ephemeral-session endpoint. Two accepted shapes:
 *
 *   - `wss://…` / `ws://…` — a WebSocket URL the terminal attaches to
 *     directly. Each connection is one ephemeral session.
 *   - `https://…` / `http://…` — an HTTP endpoint; the terminal POSTs to it
 *     and expects `{ "wsUrl": string }` back (absolute, or a path resolved
 *     against the endpoint's origin).
 *
 * The terminal auto-connects when it scrolls into view (IntersectionObserver,
 * so only engaged viewers spend one of the capacity-limited anonymous
 * sessions) and reuses one session per visit: the resolved wsUrl is cached in
 * localStorage while its short-lived attach token is still valid, so
 * navigating between pages does not burn extra sessions. On 429/503 the
 * endpoint's structured rejection maps to a clear capacity message with a
 * retry control — never a blank or fake terminal.
 *
 * The socket speaks the session shell protocol from
 * packages/worker/public/s/index.html: client sends
 * `{type:'input',data}` / `{type:'resize',cols,rows}`, server sends
 * `{type:'output',data}` (other frame types are ignored here). Rendering is
 * a real xterm.js instance, bundled locally, loaded only when the terminal
 * connects. After attach, the embed's demo script is typed into the session
 * as real keystrokes, then the keyboard is handed to the reader.
 *
 * Without the env var this renders a plain link to the hosted app instead.
 * There is no canned playback in either mode.
 */
/**
 * Demo scripts: each embed may carry a page-specific command sequence,
 * typed into the live session as real keystrokes after attach. An entry is
 * a command string or `[command, maxWaitMs]` where maxWaitMs bounds how
 * long the runner waits for a fresh prompt before moving on (default
 * 15 s — a clone or an install needs more). The runner is prompt-aware:
 * it types the next command as soon as the shell (or a REPL) shows a
 * prompt again, so variable-duration commands never race the script.
 * The page's script runs on every terminal boot, including when the
 * underlying session is reused. Keep one embed per page: a second live
 * attach would contend for the same terminal.
 */
type DemoStep = string | [string, number];
interface Props {
	title?: string;
	rows?: number;
	demo?: DemoStep[];
}
const {
	title = 'nimbus — /home/user',
	rows = 14,
	demo = [
		'node -v',
		[
			`node -e "const s='NIMBUS - a real computer at a URL';let o='';for(let i=0;i<s.length;i++)o+='\\x1b[38;5;'+(51+i*3)+'m'+s[i];console.log(o+'\\x1b[0m')"`,
			10_000,
		],
		'ls',
	],
} = Astro.props;
const demoSteps: [string, number][] = demo.map((step) =>
	typeof step === 'string' ? [step, 15_000] : step,
);

const attachUrl = import.meta.env.PUBLIC_NIMBUS_ANON_ATTACH_URL ?? '';
const appUrl = 'https://nimbus.ashishkumarsingh.com';
---

{
	attachUrl ? (
		<div
			class="nsx"
			data-nimbus-sandbox
			data-attach-url={attachUrl}
			data-demo={JSON.stringify(demoSteps)}
			style={`--nsx-rows:${rows}`}
		>
			<div class="nsx-bar">
				<span class="nsx-dots" aria-hidden="true">
					<i />
					<i />
					<i />
				</span>
				<span class="nsx-title">{title}</span>
				<span class="nsx-badge" data-role="badge" hidden />
			</div>
			<div class="nsx-screen" data-role="screen">
				<div class="nsx-status" data-role="status" aria-live="polite">
					<p data-role="message">Live sandbox — connecting…</p>
					<button type="button" data-role="retry" hidden>
						Retry
					</button>
				</div>
			</div>
		</div>
	) : (
		<div class="nsx-cta">
			<p>The hosted deployment creates a live sandbox session on open.</p>
			<a href={appUrl} target="_blank" rel="noopener">
				Open a sandbox at nimbus.ashishkumarsingh.com →
			</a>
		</div>
	)
}

<style>
	.nsx {
		border: 1px solid var(--nimbus-terminal-border);
		border-radius: var(--nimbus-panel-radius);
		overflow: hidden;
		margin: 1.25rem 0;
		background: var(--nimbus-terminal-bg);
	}
	.nsx-bar {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.45rem 0.75rem;
		background: var(--nimbus-terminal-bar-bg);
		border-bottom: 1px solid var(--nimbus-terminal-border);
		font-family: var(--sl-font-system-mono);
		font-size: 0.72rem;
	}
	.nsx-dots {
		white-space: nowrap;
		flex: 0 0 auto;
	}
	.nsx-dots i {
		display: inline-block;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		margin-right: 5px;
	}
	.nsx-dots i:nth-child(1) { background: var(--nimbus-terminal-border); }
	.nsx-dots i:nth-child(2) { background: var(--nimbus-terminal-muted); }
	.nsx-dots i:nth-child(3) { background: var(--nimbus-terminal-accent); }
	.nsx-title {
		flex: 1 1 auto;
		min-width: 0;
		color: var(--nimbus-terminal-muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.nsx-badge {
		flex: 0 0 auto;
		white-space: nowrap;
		color: var(--nimbus-terminal-accent);
		border: 1px solid color-mix(in srgb, var(--nimbus-terminal-accent) 42%, transparent);
		border-radius: 999px;
		padding: 0 0.5rem;
		letter-spacing: 0.06em;
		font-size: 0.62rem;
	}
	.nsx-badge[data-state='connecting'],
	.nsx-badge[data-state='ended'],
	.nsx-badge[data-state='error'] {
		color: var(--nimbus-terminal-muted);
		border-color: color-mix(in srgb, var(--nimbus-terminal-muted) 42%, transparent);
	}
	.nsx-screen {
		position: relative;
		height: calc(var(--nsx-rows) * 1.35rem + 1.2rem);
		padding: 0.6rem 0.4rem 0.6rem 0.75rem;
		background: var(--nimbus-terminal-bg);
	}
	.nsx-screen :global(.xterm) {
		height: 100%;
	}
	.nsx-status {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		text-align: center;
		padding: 1rem;
	}
	.nsx-status p {
		margin: 0;
		max-width: 32rem;
		color: var(--nimbus-terminal-muted);
		font-family: var(--sl-font-system-mono);
		font-size: var(--sl-text-sm);
		line-height: 1.6;
	}
	.nsx-status button {
		font: inherit;
		font-family: var(--sl-font-system-mono);
		font-size: var(--sl-text-sm);
		color: var(--nimbus-terminal-accent);
		background: transparent;
		border: 1px solid color-mix(in srgb, var(--nimbus-terminal-accent) 42%, transparent);
		border-radius: var(--nimbus-control-radius);
		padding: 0.35rem 1rem;
		cursor: pointer;
	}
	.nsx-status button:hover {
		border-color: var(--nimbus-terminal-accent);
	}
	.nsx-status button:focus-visible {
		outline: 2px solid var(--nimbus-terminal-accent);
		outline-offset: 3px;
	}

	.nsx-cta {
		border: 1px solid var(--sl-color-hairline);
		border-radius: var(--nimbus-panel-radius);
		padding: 1rem 1.25rem;
		margin: 1.25rem 0;
		background: var(--nimbus-panel-bg);
	}
	.nsx-cta p {
		margin: 0 0 0.5rem;
		color: var(--sl-color-gray-2);
	}
	.nsx-cta a {
		font-weight: 600;
		overflow-wrap: anywhere;
	}
	@media (max-width: 480px) {
		.nsx-bar {
			gap: 0.45rem;
			padding-inline: 0.6rem;
		}
		.nsx-cta { padding: 0.875rem 1rem; }
	}
</style>

<script>
	// Static so the build reliably emits it into the page CSS — a dynamic
	// stylesheet import referenced a chunk the build never wrote, which
	// rejected the whole boot after the socket was already open.
	import '@xterm/xterm/css/xterm.css';

	// A stable per-browser id keys the cached session in localStorage, so a
	// returning or refreshing visitor reattaches to the sandbox they already
	// booted instead of cold-booting a new one. The attach token lives 120 s
	// (ANON_ATTACH_TOKEN_TTL_MS), so the cache expires just inside that.
	const CLIENT_ID_KEY = 'nimbus:client-id';
	const SESSION_KEY_PREFIX = 'nimbus:anon-session:';
	const REUSE_WINDOW_MS = 110_000;
	const TERMINAL_FONT_SIZE = 13;
	const TERMINAL_FONT_FAMILY = "'JetBrains Mono', 'Fira Code', Menlo, monospace";

	function clientId(): string {
		try {
			let id = localStorage.getItem(CLIENT_ID_KEY);
			if (!id) {
				id = crypto.randomUUID();
				localStorage.setItem(CLIENT_ID_KEY, id);
			}
			return id;
		} catch {
			return 'ephemeral';
		}
	}
	const SESSION_KEY = SESSION_KEY_PREFIX + clientId();

	interface CachedSession {
		wsUrl: string;
		mintedAt: number;
	}

	class SandboxUnavailableError extends Error {
		constructor(public status: number) {
			super(`attach endpoint returned ${status}`);
		}
	}

	function readCachedSession(): CachedSession | null {
		try {
			const raw = localStorage.getItem(SESSION_KEY);
			if (!raw) return null;
			const cached = JSON.parse(raw) as CachedSession;
			if (typeof cached.wsUrl !== 'string' || typeof cached.mintedAt !== 'number') return null;
			if (Date.now() - cached.mintedAt > REUSE_WINDOW_MS) return null;
			return cached;
		} catch {
			return null;
		}
	}

	function cacheSession(wsUrl: string) {
		try {
			localStorage.setItem(SESSION_KEY, JSON.stringify({ wsUrl, mintedAt: Date.now() }));
		} catch {}
	}

	function clearCachedSession() {
		try {
			localStorage.removeItem(SESSION_KEY);
		} catch {}
	}

	async function createSession(attachUrl: string): Promise<string> {
		if (/^wss?:/i.test(attachUrl)) return attachUrl;
		const res = await fetch(attachUrl, { method: 'POST' });
		if (!res.ok) throw new SandboxUnavailableError(res.status);
		const body = (await res.json()) as { wsUrl?: string };
		if (!body.wsUrl) throw new Error('attach endpoint returned no wsUrl');
		const resolved = new URL(body.wsUrl, attachUrl);
		if (resolved.protocol === 'https:') resolved.protocol = 'wss:';
		if (resolved.protocol === 'http:') resolved.protocol = 'ws:';
		return resolved.href;
	}

	async function openSocket(wsUrl: string): Promise<WebSocket> {
		const ws = new WebSocket(wsUrl);
		await new Promise<void>((resolve, reject) => {
			ws.addEventListener('open', () => resolve(), { once: true });
			ws.addEventListener('error', () => reject(new Error('connection failed')), { once: true });
		});
		return ws;
	}

	function unavailableMessage(error: unknown): string {
		if (error instanceof SandboxUnavailableError) {
			if (error.status === 429) return 'Session limit for this address reached — try again in a minute.';
			if (error.status === 503) return 'All demo sandboxes are in use right now — try again in a minute.';
		}
		return 'The sandbox could not be started. Check the connection and retry.';
	}

	async function waitForTerminalFont(): Promise<void> {
		try {
			await document.fonts.load(`${TERMINAL_FONT_SIZE}px 'JetBrains Mono'`);
		} catch {}
		await document.fonts.ready;
	}

	async function boot(el: HTMLElement) {
		if (el.dataset.booting === 'true') return;
		el.dataset.booting = 'true';

		const screen = el.querySelector<HTMLElement>('[data-role="screen"]')!;
		const status = el.querySelector<HTMLElement>('[data-role="status"]')!;
		const message = el.querySelector<HTMLElement>('[data-role="message"]')!;
		const retryBtn = el.querySelector<HTMLButtonElement>('[data-role="retry"]')!;
		const badge = el.querySelector<HTMLElement>('[data-role="badge"]')!;
		const attachUrl = el.dataset.attachUrl!;

		function setState(state: 'connecting' | 'running' | 'live' | 'ended' | 'error', label: string) {
			badge.hidden = false;
			badge.dataset.state = state;
			badge.textContent = label;
		}

		retryBtn.hidden = true;
		message.textContent = 'Creating a session…';
		setState('connecting', 'connecting…');

		try {
			// Load xterm while the session mints and the sandbox boots, so the
			// bundle fetch overlaps the slow WS-attach boot instead of running
			// after it.
			const termModules = Promise.all([
				import('@xterm/xterm'),
				import('@xterm/addon-fit'),
			]);
			const terminalFontReady = waitForTerminalFont();

			// Reuse the visit's session when possible; fall back to a fresh
			// one if the cached attach URL no longer connects.
			const cached = readCachedSession();
			let ws: WebSocket;
			let reused = cached !== null;
			if (cached) {
				try {
					ws = await openSocket(cached.wsUrl);
				} catch {
					clearCachedSession();
					reused = false;
					const wsUrl = await createSession(attachUrl);
					cacheSession(wsUrl);
					ws = await openSocket(wsUrl);
				}
			} else {
				const wsUrl = await createSession(attachUrl);
				cacheSession(wsUrl);
				ws = await openSocket(wsUrl);
			}

			const [{ Terminal }, { FitAddon }] = await termModules;
			await terminalFontReady;

			const terminalBackground = getComputedStyle(el)
				.getPropertyValue('--nimbus-terminal-bg')
				.trim();
			const term = new Terminal({
				cursorBlink: true,
				cursorStyle: 'bar',
				fontSize: TERMINAL_FONT_SIZE,
				fontFamily: TERMINAL_FONT_FAMILY,
				theme: {
					background: terminalBackground,
					foreground: '#c9d1d9',
					cursor: '#58a6ff',
					selectionBackground: '#264f78',
					black: '#484f58', red: '#ff7b72', green: '#3fb950', yellow: '#d29922',
					blue: '#58a6ff', magenta: '#bc8cff', cyan: '#39d353', white: '#c9d1d9',
					brightBlack: '#6e7681', brightRed: '#ffa198', brightGreen: '#56d364',
					brightYellow: '#e3b341', brightBlue: '#79c0ff', brightMagenta: '#d2a8ff',
					brightCyan: '#56d364', brightWhite: '#f0f6fc',
				},
			});
			const fit = new FitAddon();
			term.loadAddon(fit);
			const send = (frame: object) => {
				if (ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify(frame));
			};
			const fitTerminal = (refreshMetrics = false) => {
				if (screen.offsetWidth === 0 || screen.offsetHeight === 0) return;
				if (refreshMetrics) {
					// xterm ignores same-value option assignments, so toggle
					// through its fallback before fitting to remeasure the cell.
					term.options.fontFamily = 'monospace';
					term.options.fontFamily = TERMINAL_FONT_FAMILY;
				}
				fit.fit();
				send({ type: 'resize', cols: term.cols, rows: term.rows });
			};

			status.hidden = true;
			term.open(screen);
			fitTerminal();
			await new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
			fitTerminal(true);
			term.focus();

			// Keep the session warm so typed input is always serviced. An idle
			// hibernatable session stops acting on input frames until something
			// wakes it, which is why a command typed after the demo could look
			// dead; a periodic no-op resize keeps it awake. It runs only while
			// the tab and the terminal are on screen, so a session the reader
			// has scrolled past is free to hibernate.
			const onScreen = () => {
				if (document.visibilityState !== 'visible') return false;
				const r = el.getBoundingClientRect();
				return r.bottom > 0 && r.top < window.innerHeight;
			};
			const keepalive = window.setInterval(() => {
				if (ws.readyState === WebSocket.OPEN && onScreen()) {
					send({ type: 'resize', cols: term.cols, rows: term.rows });
				}
			}, 5000);

			// Stick-to-bottom: new output and the reader's own keystrokes scroll
			// the viewport to the latest line, so a typed command and its output
			// are always in view. Scrolling up to read releases the lock until
			// the reader returns to the bottom or types again.
			let stickToBottom = true;
			let userScrollGesture = false;
			const atBottom = () => {
				const buffer = term.buffer.active;
				return buffer.viewportY >= buffer.baseY;
			};
			const pinToBottom = () => {
				term.scrollToBottom();
				stickToBottom = true;
			};
			term.onScroll(() => {
				if (atBottom()) {
					stickToBottom = true;
				} else if (userScrollGesture) {
					stickToBottom = false;
				}
			});
			const viewport = screen.querySelector<HTMLElement>('.xterm-viewport')!;
			const userScrollListeners = new AbortController();
			const trackUserScroll = () => {
				userScrollGesture = true;
				requestAnimationFrame(() => {
					stickToBottom = atBottom();
					userScrollGesture = false;
				});
			};
			const gestureOptions = {
				capture: true,
				signal: userScrollListeners.signal,
			};
			viewport.addEventListener('wheel', trackUserScroll, { ...gestureOptions, passive: true });
			viewport.addEventListener('touchmove', trackUserScroll, { ...gestureOptions, passive: true });
			screen.addEventListener('keydown', trackUserScroll, gestureOptions);
			viewport.addEventListener('pointerdown', () => {
				userScrollGesture = true;
			}, gestureOptions);
			const endUserScroll = () => {
				userScrollGesture = false;
			};
			window.addEventListener('pointerup', endUserScroll, gestureOptions);
			window.addEventListener('pointercancel', endUserScroll, gestureOptions);

			// Rolling ANSI-stripped output tail, so the demo runner can see when
			// the shell (or a REPL) is back at a prompt.
			let outputTail = '';
			let lastOutputAt = 0;
			ws.addEventListener('message', (e) => {
				try {
					const msg = JSON.parse(e.data);
					if (msg.type === 'output') {
						term.write(msg.data, () => {
							if (stickToBottom) pinToBottom();
						});
						outputTail = (
							outputTail + msg.data.replace(/\x1b\[[0-9;?]*[A-Za-z]/g, '')
						).slice(-80);
						lastOutputAt = Date.now();
					}
				} catch {}
			});
			let steps: [string, number][] = [];
			try {
				steps = JSON.parse(el.dataset.demo ?? '[]');
			} catch {}
			let readerInputEnabled = steps.length === 0;
			setState(readerInputEnabled ? 'live' : 'running', readerInputEnabled ? 'live' : 'running…');

			term.onData((d) => {
				if (!readerInputEnabled) return;
				pinToBottom();
				send({ type: 'input', data: d });
			});
			const resizeObserver = new ResizeObserver(() => fitTerminal(true));
			resizeObserver.observe(screen);
			ws.addEventListener('close', () => {
				clearInterval(keepalive);
				userScrollListeners.abort();
				resizeObserver.disconnect();
				setState('ended', 'session ended');
			});

			// This embed's demo script: real keystrokes into the live
			// session, then the keyboard is the reader's.
			if (steps.length > 0) {
				const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
				const type = async (line: string) => {
					for (const ch of line) {
						send({ type: 'input', data: ch });
						await sleep(24 + Math.random() * 28);
					}
					send({ type: 'input', data: '\r' });
				};
				// A shell prompt ends "$ "; REPL prompts end ">>> " or "> ".
				// Quiescence guards against echo chunks that happen to end at
				// a prompt boundary while a command is still producing output.
				// The keepalive above keeps the session warm during long waits.
				// Bounded so a prompt-regex miss can never leave the reader's
				// keyboard blocked forever — input is handed back either way.
				const waitForPrompt = async (maxMs = 15_000): Promise<void> => {
					const start = Date.now();
					await sleep(500);
					while (Date.now() - start < maxMs) {
						if (/(\$ |>>> |> )$/.test(outputTail) && Date.now() - lastOutputAt > 600) {
							return;
						}
						await sleep(200);
					}
				};
				await sleep(reused ? 400 : 1200);
				if (reused) send({ type: 'input', data: '\r' });
				await waitForPrompt(8000);
				for (const [cmd, maxWaitMs] of steps) {
					outputTail = '';
					await type(cmd);
					await waitForPrompt(maxWaitMs);
					await sleep(700);
				}
				await waitForPrompt();
				readerInputEnabled = true;
				if (ws.readyState === WebSocket.OPEN) setState('live', 'live');
			} else {
				// Reattached with nothing to type: there is no scrollback
				// replay yet, so nudge a fresh prompt.
				send({ type: 'input', data: '\r' });
			}
			pinToBottom();
			term.focus();
		} catch (error) {
			el.dataset.booting = 'false';
			setState('error', 'unavailable');
			message.textContent = unavailableMessage(error);
			retryBtn.hidden = false;
		}
	}

	document.querySelectorAll<HTMLElement>('[data-nimbus-sandbox]').forEach((el) => {
		el.querySelector('[data-role="retry"]')?.addEventListener('click', () => void boot(el));

		// Prewarm on approach: start the boot once the terminal is within ~one
		// screen of the viewport, so the slow WS-attach boot overlaps the last
		// stretch of scrolling and the terminal is usually live by the time it
		// is reached. Still gated on the reader scrolling toward it, so a page
		// load that never nears it does not spend a capacity-limited session.
		const observer = new IntersectionObserver(
			(entries) => {
				if (entries.some((entry) => entry.isIntersecting)) {
					observer.disconnect();
					void boot(el);
				}
			},
			{ rootMargin: '800px 0px', threshold: 0 },
		);
		observer.observe(el);
	});
</script>
